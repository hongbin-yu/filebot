  {
    "id": "api-data-card",
    "name": "api-data-card",
    "display_name": "API数据卡片",
    "category": "content",
    "description": "从API获取JSON数据并显示为卡片，支持WET-BOEW动态加载",
    "icon": "fas fa-database",
    "html_template": "<div class=\"api-data-card\" data-wb-json='{{api_url}}'>\n    <div class=\"card\">\n        <div class=\"card-header\">\n            <h3 class=\"card-title\" data-json-key=\"{{title_field}}\">加载中...</h3>\n        </div>\n        <div class=\"card-body\">\n            <img src=\"\" alt=\"\" class=\"card-img-top mb-3\" data-json-key=\"{{image_field}}\" style=\"max-height: 200px; display: none;\">\n            <p class=\"card-text\" data-json-key=\"{{description_field}}\">正在加载数据...</p>\n        </div>\n        <div class=\"card-footer\">\n            <small class=\"text-muted\">数据来源: {{api_url}}</small>\n        </div>\n    </div>\n</div>\n\n<!-- 如果API不支持CORS，使用服务器端代理 -->\n<script>\n// 备选方案：如果WET-BOEW插件不可用，使用fetch API\ndocument.addEventListener('DOMContentLoaded', function() {\n    var cards = document.querySelectorAll('.api-data-card:not([data-processed])');\n    cards.forEach(function(card) {\n        card.setAttribute('data-processed', 'true');\n        var apiUrl = card.getAttribute('data-wb-json');\n        var titleField = card.querySelector('[data-json-key]').getAttribute('data-json-key');\n        var descField = card.querySelectorAll('[data-json-key]')[1].getAttribute('data-json-key');\n        var imgField = card.querySelectorAll('[data-json-key]')[2].getAttribute('data-json-key');\n        \n        fetch(apiUrl)\n            .then(response => response.json())\n            .then(data => {\n                // 简单路径解析（只支持一级）\n                var title = data[titleField] || '无标题';\n                var description = data[descField] || '无描述';\n                var image = data[imgField] || '';\n                \n                card.querySelector('.card-title').textContent = title;\n                card.querySelector('.card-text').textContent = description;\n                if (image) {\n                    var img = card.querySelector('img');\n                    img.src = image;\n                    img.style.display = 'block';\n                    img.alt = title;\n                }\n            })\n            .catch(error => {\n                console.error('API数据获取失败:', error);\n                card.querySelector('.card-title').textContent = '数据加载失败';\n                card.querySelector('.card-text').textContent = '无法从API获取数据: ' + error.message;\n            });\n    });\n});\n</script>",
    "css_template": "",
    "js_template": "",
    "properties": {
      "api_url": {
        "name": "api_url",
        "type": "url",
        "label": "API端点URL",
        "description": "提供JSON数据的API端点URL",
        "default": "https://api.example.com/data",
        "required": true,
        "options": null,
        "i18n": false,
        "min_length": null,
        "max_length": null,
        "min_value": null,
        "max_value": null
      },
      "title_field": {
        "name": "title_field",
        "type": "string",
        "label": "标题字段路径",
        "description": "JSON中标题字段的路径（如：title, data.title）",
        "default": "title",
        "required": false,
        "options": null,
        "i18n": false,
        "min_length": null,
        "max_length": null,
        "min_value": null,
        "max_value": null
      },
      "description_field": {
        "name": "description_field",
        "type": "string",
        "label": "描述字段路径",
        "description": "JSON中描述字段的路径（如：description, data.description）",
        "default": "description",
        "required": false,
        "options": null,
        "i18n": false,
        "min_length": null,
        "max_length": null,
        "min_value": null,
        "max_value": null
      },
      "image_field": {
        "name": "image_field",
        "type": "string",
        "label": "图片字段路径",
        "description": "JSON中图片URL字段的路径（如：image, data.image_url）",
        "default": "image",
        "required": false,
        "options": null,
        "i18n": false,
        "min_length": null,
        "max_length": null,
        "min_value": null,
        "max_value": null
      }
    },
    "dependencies": [],
    "wet_boew_compliant": true,
    "accessibility_checked": false,
    "tags": [
      "api",
