  {
    "id": "mustache-renderer",
    "name": "mustache-renderer",
    "display_name": "Mustache模板渲染器",
    "category": "custom",
    "description": "渲染Mustache模板，支持变量替换、条件语句和循环",
    "icon": "fas fa-code",
    "html_template": "<div class=\"mustache-renderer-container\" data-template=\"{{template_text}}\" data-json=\"{{json_data}}\" data-escape-html=\"{{escape_html}}\">\n    <!-- Mustache渲染内容将在这里显示 -->\n    <div class=\"mustache-placeholder\">\n        <p><em>Mustache模板渲染器 - 内容将在页面加载时渲染</em></p>\n    </div>\n    <noscript>\n        <div class=\"alert alert-warning\">\n            <strong>提示：</strong>此组件需要JavaScript支持才能正确渲染。\n        </div>\n    </noscript>\n</div>",
    "css_template": ".mustache-renderer-container {\n    border: 1px solid #ddd;\n    border-radius: 4px;\n    padding: 15px;\n    margin: 10px 0;\n    background-color: #f9f9f9;\n}\n.mustache-placeholder {\n    color: #666;\n    font-style: italic;\n    padding: 10px;\n    background-color: #f0f0f0;\n    border-radius: 3px;\n}",
    "js_template": "// Mustache渲染器客户端逻辑\n(function() {\n    const containers = document.querySelectorAll('.mustache-renderer-container');\n    containers.forEach(container => {\n        const template = container.getAttribute('data-template');\n        const jsonData = container.getAttribute('data-json');\n        const escapeHtml = container.getAttribute('data-escape-html') === 'true';\n        \n        try {\n            const data = JSON.parse(jsonData);\n            // 这里可以添加客户端渲染逻辑，如果需要的话\n            // 当前版本主要依赖服务器端渲染\n        } catch (e) {\n            console.error('Mustache渲染器JSON解析错误:', e);\n        }\n    });\n})();",
    "properties": {
      "template_text": {
        "name": "template_text",
        "type": "text",
        "label": "Mustache模板",
        "default": "<h1>{{title}}</h1>\n<p>{{content}}</p>\n{{#if show_more}}\n<div class=\"more-content\">{{more_text}}</div>\n{{/if}}",
        "required": true,
        "description": "使用{{变量}}语法的Mustache模板",
        "multiline": true,
        "rows": 8
      },
      "json_data": {
        "name": "json_data",
        "type": "json",
        "label": "JSON数据",
        "default": "{\"title\": \"示例标题\", \"content\": \"示例内容\", \"show_more\": true, \"more_text\": \"更多内容...\"}",
        "required": true,
        "description": "提供模板变量的JSON对象",
        "multiline": true,
        "rows": 8
      },
      "escape_html": {
        "name": "escape_html",
        "type": "boolean",
        "label": "HTML转义",
        "default": true,
        "description": "渲染时自动转义HTML特殊字符，防止XSS攻击"
      }
    },
    "dependencies": [],
    "wet_boew_compliant": false,
    "accessibility_checked": false,
    "tags": [
      "template",
      "mustache",
      "dynamic",
      "json"
    ],
    "author": "WebBot System",
    "version": "1.0.0",
    "status": "published",
    "created_by": "system",
    "created_at": "2026-04-10T10:50:16.323615",
    "updated_at": "2026-04-10T10:50:16.323624",
    "usage_count": 0
