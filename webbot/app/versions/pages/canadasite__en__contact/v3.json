  "content": "<div class=\"mwstitle section\">\n\n    <h1 property=\"name\" id=\"wb-cont\" dir=\"ltr\">\nGovernment of Canada contacts</h1>\n\t</div>\n<div class=\"mwsgeneric-base-html parbase section\">\n\n\n\n      <div class=\"row\"> \n   <div class=\"col-md-12\"> \n    <h2>Most frequent contacts</h2> \n   </div> \n   <div> \t\n\n<section class=\" well-sm\"><div class=\"container row-no-gutters\">\n    <div class=\"col-md-4\">\n          <h3>Benefits</h3>\n                <ul class=\"list-unstyled lst-spcd\"><li><a href=\"https://www.canada.ca/en/employment-social-development/corporate/contact/ei-individual.html\">Employment Insurance (<abbr>EI</abbr>) for individuals</a></li>\n                  <li><a href=\"https://www.canada.ca/en/employment-social-development/corporate/contact/employment-insurance-employers.html\">Employment Insurance (<abbr>EI</abbr>) for employers</a></li>\n                  <li><a href=\"https://www.canada.ca/en/employment-social-development/corporate/contact/cpp.html\">Canada Pension Plan (<abbr>CPP</abbr>)</a></li>\n                  <li><a href=\"https://www.canada.ca/en/employment-social-development/corporate/contact/oas.html\">Old Age Security (<abbr>OAS</abbr>)</a></li>\n<li><a href=\"/en/services/benefits/dental/dental-care-plan/contact.html\">Canadian Dental Care Plan</a></li>\n<li><a href=\"/en/services/benefits/disability/canada-disability-benefit/contact.html\">Canada Disability Benefit</a></li>\n<li><a href=\"/en/revenue-agency/services/child-family-benefits/canada-child-benefit/contact.html\">Canada child benefit (CCB)</a></li>\n                </ul></div>\n\n      <div class=\"col-md-4\">\n    <h3>Taxes</h3>\n                <ul class=\"list-unstyled lst-spcd\"><li><a href=\"https://www.canada.ca/en/revenue-agency/corporate/contact-information.html\">Taxes for Canadians and businesses</a> </li>\n                  <li><a href=\"https://www.canada.ca/en/revenue-agency/corporate/contact-information.html#tbl-international\">International tax and non-resident enquiries</a></li>\n                  <li><a href=\"https://www.canada.ca/en/employment-social-development/corporate/contact/sin.html\">Social Insurance Number (<abbr>SIN</abbr>)</a></li>\n\n\n                </ul></div>\n\n <div class=\"col-md-4\">\n    <h3>Immigration and travel</h3>\n                <ul class=\"list-unstyled lst-spcd\"><li><a href=\"https://www.canada.ca/en/immigration-refugees-citizenship/corporate/contact-ircc.html\">eTAs, visas, permits, permanent residence, immigration</a></li>\n                  <li><a href=\"http://www.cbsa-asfc.gc.ca/contact/bis-sif-eng.html\">Crossing the border</a></li>\n                  <li><a href=\"https://travel.gc.ca/assistance\">Travel assistance abroad for Canadians</a></li>\n                  <li><a href=\"https://www.canada.ca/en/immigration-refugees-citizenship/services/canadian-passports/contact-passport-program.html\">Passports for Canadians</a></li>\n                </ul></div>\n</div></section><section class=\" well well-sm brdr-0 mrgn-bttm-0\"><div class=\"container row-no-gutters\">\n    <div class=\"col-md-4\">\n      <h3>Representatives and employees</h3>\n                <ul class=\"list-unstyled lst-spcd\"><li><a href=\"https://gcdirectory-gcannuaire.ssc-spc.gc.ca/en/GCD/?rd=1&amp;pgid=002\">Government employee directory</a></li>\n                  <li><a href=\"https://www.ourcommons.ca/Members/en/search\">Find your Member of Parliament</a>\n                  </li>\n                  <li><a href=\"https://sencanada.ca/en/senators/\">Members of the Senate</a></li>\n                  <li><a href=\"http://www.international.gc.ca/protocol-protocole/reps.aspx?lang=eng&amp;view=d&amp;_ga=1.105605379.1867445363.1441994342\">Foreign representatives in Canada</a></li>\n\n                </ul></div>\n\n\n<div class=\"col-md-4\">\n<h3>Change your address or banking information</h3>\n<ul class=\"list-unstyled lst-spcd\"><li><a href=\"/en/government/change-address.html\">Change your address</a></li>\n<li><a href=\"/en/public-services-procurement/services/payments-to-from-government/direct-deposit.html\">Sign up for direct deposit or update your banking information</a></li></ul></div>\n\n   <div class=\"col-md-4\">\n    <h3>Get general help</h3>\n                              <ul class=\"list-unstyled lst-spcd\"><li><a href=\"https://www.canada.ca/en/contact/contact-1-800-o-canada.html\">By telephone</a></li>\n                                <li><a href=\"https://www.canada.ca/en/contact/questions.html\">By email</a></li></ul></div>\n\n  </div>\n</section></div></div>\n\n\n</div>\n<div class=\"mwsgeneric-base-html parbase section\">\n\n\n\n       <section><div class=\"row profile\"> \n   <div class=\"col-md-12\"> \n    <h2 id=\"contact-table\">Find contacts by department or program</h2> \n    <p class=\"pagetag\">Enter a department name or abbreviation to find a contact us page.</p> \n   </div> \n  </div> \n\n  <table class=\"wb-tables table filterEmphasis provisional wb-init wb-tables-inited\" data-wb-tables='{\"aLengthMenu\": [[10, 25, 50, 100, -1], [10, 25, 50, 100, \"All\"]],       \"iDisplayLength\": 10          }' id=\"wb-auto-4\"><thead><tr><th>Department contacts</th> \n     <th>Abbreviation</th> \n      \n    </tr></thead><tbody><tr><td><a href=\"https://accessible.canada.ca/contact\">Accessibility Standards Canada</a></td> \n     <td>ASC</td> \n    </tr><tr><td><a href=\"/en/administrative-tribunals-support-service/contact.html\">Administrative Tribunals Support Service of Canada</a></td> \n     <td>ATSSC</td> \n    </tr><tr><td><a href=\"https://agriculture.canada.ca/en/contact\">Agriculture and Agri-Food Canada</a></td> \n     <td>AAFC</td> \n    </tr><tr><td><a href=\"/en/atlantic-canada-opportunities.html\">Atlantic Canada Opportunities Agency</a></td> \n     <td>ACOA</td> \n    </tr><tr><td><a href=\"https://www.atlanticpilotage.com/contact/\">Atlantic Pilotage Authority Canada</a></td> \n     <td>APA</td> \n    </tr><tr><td><a h