  "content": "<div class=\"mwscolumns section\">\n    \n\n    \n\n        \n\n        \n            \n        <div class=\"row \">\n            \n                <div class=\"col-md-7\">\n                    <div class=\"mwsbodytext text parbase section\">\n    \n\n    \n        <h1 property=\"name\" id=\"wb-cont\">Canadian Special Operations Forces Command</h1>\n\n    \n\n\n</div>\n<div class=\"mwsbodytext text parbase section\">\n    \n\n    \n        <p>The Canadian Special Operations Forces Command (CANSOFCOM) is a part of <a href=\"/en/department-national-defence.html\">National Defence and the Canadian Armed Forces</a>. It is a high-readiness organization, able to deploy agile, special operations forces on very short notice on behalf of the Government of Canada in order to protect Canadians from threats at home and abroad.</p>\n\n    \n\n\n</div>\n<div class=\"mwsfollowus section\">\n\n\n\n    <section class=\"followus mrgn-tp-md wb-init followus-inited\" id=\"wb-auto-4\"><h2>Follow:</h2>\n        <ul><li><a rel=\"external\" class=\"facebook\" href=\"http://www.facebook.com/CanadianForces\"><span class=\"wb-inv\">Facebook</span></a></li>\n            <li><a rel=\"external\" class=\"twitter\" href=\"https://twitter.com/CanadianForces\"><span class=\"wb-inv\">X</span></a></li>\n            <li><a rel=\"external\" class=\"youtube\" href=\"https://www.youtube.com/user/CanadianForcesVideos\"><span class=\"wb-inv\">YouTube</span></a></li>\n            \n            \n            \n            <li><a rel=\"external\" class=\"linkedin\" href=\"https://www.linkedin.com/company/canadian-forces/\"><span class=\"wb-inv\">LinkedIn</span></a></li>\n            \n            \n            \n            \n        </ul></section></div>\n\n\n                </div>\n            \n                <div class=\"col-md-5\">\n                    <div class=\"mwsgeneric-base-html parbase section\">\n\n\n\n    <div> <img alt=\"CANSOFCOM crest\" class=\"mrgn-tp-sm center-block\" src=\"/content/dam/themes/defence/caf/identity-system/badges/command/canadian-special-operations-forces-command-250.png\"></div>\n\n\n\n</div>\n\n\n                </div>\n            \n        </div>\n    \n        \n    \n\n\n\n</div>\n<div class=\"mwsbodytext text parbase section\">\n    \n\n    \n        <h2>Latest news</h2>\n\n    \n\n\n</div>\n<div class=\"mwscolumns section\">\n    \n\n    \n\n        \n\n        \n            \n        <div class=\"row \">\n            \n                <div class=\"col-md-7\">\n                    <div class=\"mwsgeneric-base-html parbase section\">\n\n\n\n    <figure><img class=\"img-responsive full-width\" src=\"/content/dam/cansofcom-comfoscan/images/news/MANTIS26-News.jpg\" alt=\"Four Malaysian soldiers dressed in black uniforms and combat gear, gas masks and carbines are climbing onto a docked ship’s gangway to board the ship, with a Canadian soldier in multicam uniform, combat gear and gas mask following close behind. The first Malaysian soldier has a black shield raised up in front of him. They are on a concrete dock by the sea.\"><figcaption><p class=\"small\">CJIRU members recently completed Ex MANTIS 2026 in Malaysia. 12 years running, the Ex is a staple of Canada’s Indo-Pacific strategy. This serial shifted focus towards a joint chemical, biological and radiological response, with tactical and technical integration of MAF elements.</p>\n</figcaption></figure></div>\n\n\n                </div>\n            \n                <div class=\"col-md-5\">\n                    <div class=\"mwsbodytext text parbase section\">\n    \n\n    \n        <p><a href=\"/en/department-national-defence/maple-leaf/defence/2026/04/ex-mantis-twelve-years-cooperation-malaysian-armed-forces.html\">Ex MANTIS: Twelve years of cooperation with the Malaysian Armed Forces</a><br><span class=\"small\">2026-04-07</span></p>\n<p><a href=\"/en/department-national-defence/maple-leaf/defence/2026/03/canadian-joint-incident-response-unit.html\">Become the capability: Canadian Joint Incident Response Unit (CJIRU)</a><br><span class=\"small\">2026-03-09</span></p>\n<p><a href=\"/en/department-national-defence/maple-leaf/defence/2025/11/cansofcom-arctic-exercising-pursuit-excellence.html\">CANSOFCOM in the Arctic – Exercising in pursuit of excellence</a><br><span class=\"small\">2025-11-27</span></p>\n<p><a href=\"/en/department-national-defence/maple-leaf/defence/2024/02/special-operations-task-gorce-receives-commander-in-chief-unit-commendation.html\">Special Operations Task Force receives Commander-in-Chief Unit Commendation</a><br><span class=\"small\">2024-02-13</span></p>\n<p><a href=\"/en/department-national-defence/maple-leaf/defence/2023/12/innovation-defence-excellence-security-malicious-actors-online.html\">Innovation for Defence Excellence and Security program invests in identifying malicious actors online</a><br><span class=\"small\">2023-12-11</span></p>\n<p><a href=\"/en/department-national-defence/maple-leaf/search.html?q=CANSOFCOM&amp;_=167665914\">More news</a></p>\n\n    \n\n\n</div>\n\n\n                </div>\n            \n        </div>\n    \n        \n    \n\n\n\n</div>\n<div class=\"mwscolumns section\">\n\n    <div class=\"row row mrgn-tp-lg\">\n        \n            <div class=\"col-md-4 col-xs-12 pull-right\">\n                <div class=\"mwslink-box section\">\n\n\n    \n\n    <section class=\"lnkbx well\"><h2 class=\"mrgn-tp-0\">Most requested</h2>\n\n        <ul><li>\n                    <a href=\"/en/special-operations-forces-command/corporate/job-opportunities/how-to-join.html\" title=\"How to apply\">How to apply \n\n</a>\n                </li>\n            \n                <li>\n                    <a href=\"https://forces.ca/en/\" title=\"Canadian Armed Forces Recruiting\">Canadian Armed Forces Recruiting \n\n</a>\n                </li>\n            \n                <li>\n                    <a href=\"/en/special-operations-forces-command/corporate/job-opportunities/find-recruiter