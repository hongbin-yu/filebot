\n    .gradient-bg {\n        background-image: linear-gradient(to right, #4b4e58, #11202d);\n    }\n\n    .white-text {\n        color: white;\n    }\n\n    .white-link,\n    .white-link:visited,\n    a.white-link,\n    a.white-link:visited {\n        color: white;\n        text-decoration: underline solid white;\n        transition: text-decoration-color 0.15s ease-in-out;\n        text-underline-offset: 4px;\n    }\n\n    .white-link:hover,\n    .white-link:focus,\n    a.white-link:hover,\n    a.white-link:focus {\n        text-decoration-color: #1b77a5;\n    }\n\n    .news-section {\n        background: linear-gradient(to right, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0)),\n            url('/content/dam/dia-aid/news.png') no-repeat;\n        background-position: right top;\n        background-size: 40% auto;\n    }\n\n    .card-link,\n    .card-link:visited {\n        text-decoration: none;\n    }\n\n\n    .card-link,\n    .card-link:hover,\n    .card-link:focus,\n    .card-link:visited {\n        text-decoration: none;\n        display: block;\n    }\n\n    .img-heading-inline {\n        display: flex;\n        align-items: flex-start;\n        gap: 1em;\n    }\n\n    .img-heading-inline img {\n        flex-shrink: 0;\n    }\n\n    .img-heading-inline h3 {\n        flex-grow: 1;\n        margin: 0;\n    }\n\n.mobile-menu{\ndisplay: none;\n}\n\n    @media only screen and (min-width: 992px) {\n        .white-box {\n            background-color: rgba(255, 255, 255, 0.8);\n            position: absolute;\n            width: 66%;\n            height: 9em;\n            margin-top: 1em;\n            margin-bottom: 2em;\n        }\n\n        .title-text {\n            position: relative;\n            margin-top: 2em;\n            margin-bottom: 3%;\n            width: 66%;\n        }\n    }\n\n    @media screen and (max-width: 991px) {\n        .sm-white-bg {\n            background-color: rgba(255, 255, 255, 0.8);\n            padding-top: 1em;\n            padding-bottom: 1em;\n            margin-top: 1em;\n            margin-bottom: 1em;\n        }\n\n        .news-section {\n            background: none;\n        }\n    }\n\n    @media screen and (max-width: 512px) {\n        .horizontal-list {\n            display: flex;\n            flex-direction: column;\n            align-items: flex-start;\n            gap: 0.75em;\n            margin-left: 1em;\n            margin-top: 1em;\n        }\n#dia-site-nav{\ndisplay: none;\n}\n\n.menu-icon{\npadding-right: 14px;\n}\n\n.flex-menu{\ndisplay: flex;\nalign-items: center;\n}\n\n.flex-menu, .menu-links li{\npadding: 14px 16px;\nborder-bottom: grey 1px solid;\n}\n\n.mobile-menu{\noverflow: hidden;\nposition: relative;\ndisplay: block;\nbackground-color: #11202d;\ncolor: white;\n}\n\n.menu-links{\ndisplay: none;\n}\n\n.mobile-menu a {\ncolor: white;\ntext-decoration: none;\ndisplay: block;\n}\n\n.menu-icon {\npadding-right: 14px;\ncolor: white;\n}\n\n.mobile-menu .menu-icon {\ndisplay: block;\nposition: absolute;\nright: 0;\n}\n\n.dia-menu{\ndisplay: none;\n}\n\n    }\n</style></div>\n<div class=\"mwsgeneric-base-html parbase section\">\n\n\n\n    <div class=\"mobile-menu\">\n    <ul class=\"list-unstyled item-padding mrgn-bttm-0\"><li class=\"menu-hamburger\">\n            <a href=\"javascript:void(0);\" onclick=\"openMobileMenu()\"><span class=\"flex-menu\">Menu\n                    <span class=\"menu-icon\">\n                        <i class=\"glyphicon glyphicon-menu-hamburger\"></i>\n                    </span>\n                </span>\n            </a>\n            <ul class=\"menu-links list-unstyled\" id=\"dia-menu\"><li><a href=\"/en/defence-investment-agency/corporate/about.html\">About us</a></li>\n                <li><a href=\"/en/defence-investment-agency/programs/projects-partnerships.html\">Projects and partnerships</a></li>\n                <li><a href=\"/en/defence-investment-agency/corporate/contact.html\">Contact us</a></li>\n            </ul></li>\n    </ul></div>\n\n\n</div>\n<div class=\"mwsgeneric-base-html parbase section\">\n\n\n\n    <div id=\"dia-site-nav\" class=\"content-section\">\n    <div class=\"container\">\n        <ul class=\"horizontal-list\"><li><a class=\"nav-link\" href=\"/en/defence-investment-agency/corporate/about.html\">About us</a></li>\n            <li><a class=\"nav-link\" href=\"/en/defence-investment-agency/programs/projects-partnerships.html\">Projects and partnerships</a></li>\n            <li><a class=\"nav-link\" href=\"/en/defence-investment-agency/corporate/contact.html\">Contact us</a></li>\n        </ul></div>\n</div>\n<div class=\"clearfix\"></div>\n<div class=\"bg-center bg-cover wb-init wb-bgimg-inited\" data-bgimg-srcset=\"/content/dam/pspc-spac/images/placeholder/1x1.png 991w, /content/dam/dia-aid/LandingPageBanner.jpg 992w\" id=\"wb-auto-2\" style='background-image: url(\"/content/dam/dia-aid/LandingPageBanner.jpg\");'>\n    <div class=\"container\">\n        <div class=\"row mrgn-bttm-md\">\n            <div class=\"col-md-7\">\n                <h1 property=\"name\" id=\"wb-cont\">Defence Investment Agency</h1>\n                <p>The Defence Investment Agency is modernizing Canada’s defence procurement by centralizing expertise, cutting red tape and streamlining decisions. This means faster delivery of critical equipment to the Canadian Armed Forces and the Canadian Coast Guard, protecting Canada’s sovereignty and strengthening our armed forces.</p>\n            </div>\n        </div>\n    </div>\n</div>\n<div class=\"clearfix\"></div>\n\n<div class=\"bg-topograghic\">\n    <div class=\"white-box\"></div>\n    <div class=\"sm-white-bg\">\n        <div class=\"container\">\n            <div class=\"title-text\">\n                <h2>Projects and partnerships</h2>\n                <p>Showcasing key initiatives, strategic collaborations and innovative projects that advance our mandate and foster growth and innovation with Canadian industry</p>\n            </div>\n        </div>\n    </div>\n    <div class=\"container\">\n        \n        <div class=\"card-container row wb-eqht mrgn-bttm-md mrgn-tp-lg wb-init wb-eqht-inited\" id=\"wb-auto-3\">\n            <div class=\"col-md-3 col-sm-6 col-xs-12\" style=\"vertical-align: top; min-height: 326px;\">\n                <a href=\"/en/defence-investment-agency/programs/projects-partnerships.html#air\" class=\"card-link hght-inhrt\">\n                    <div class=\"card box-shadow hght-inhrt mrgn-bttm-md\">\n                        <div class=\"img-heading-inline mrgn-bttm-md\">\n                            <img class=\"mrgn-rght-sm service-icon\" src=\"/content/dam/dia-aid/icon-air.png\" alt=\"\"><h3 class=\"mrgn-tp-sm h5\">Air and space</h3>\n                        </div>\n                        <p>Enhancing radar, surveillance, early warning and air mobility to strengthen Canada’s aerospace capabilities</p>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-md-3 col-sm-6 col-xs-12\" style=\"vertical-align: top; min-height: 326px;\">\n                <a href=\"/en/defence-investment-agency/programs/projects-partnerships.html#joint\" class=\"card-link hght-inhrt\">\n                    <div class=\"card box-shadow hght-inhrt mrgn-bttm-md\">\n                        <div class=\"img-heading-inline mrgn-bttm-md\">\n                            <img class=\"mrgn-rght-sm service-icon\" src=\"/content/dam/dia-aid/icon-jointdigital.png\" alt=\"\"><h3 class=\"mrgn-tp-sm h5\">Joint and digital</h3>\n                        </div>\n                        <p>Using advanced technology and training to help protect Canada and North America</p>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-md-3 col-sm-6 col-xs-12\" style=\"vertical-align: top; min-height: 326px;\">\n                <a href=\"/en/defence-investment-agency/programs/projects-partnerships.html#sea\" class=\"card-link hght-inhrt\">\n                    <div class=\"card box-shadow hght-inhrt mrgn-bttm-md\">\n                        <div class=\"img-heading-inline mrgn-bttm-md\">\n                            <img class=\"mrgn-rght-sm service-icon\" src=\"/content/dam/dia-aid/icon-sea.png\" alt=\"\"><h3 class=\"mrgn-tp-sm h5\">Sea</h3>\n                        </div>\n                        <p>Modernizing submarines and naval systems to support Arctic sovereignty and maritime defence</p>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-md-3 col-sm-6 col-xs-12\" style=\"vertical-align: top; min-height: 326px;\">\n                <a href=\"/en/defence-investment-agency/programs/projects-partnerships.html#land\" class=\"card-link hght-inhrt\">\n                    <div class=\"card box-shadow hght-inhrt mrgn-bttm-md\">\n                        <div class=\"img-heading-inline mrgn-bttm-md\">\n                            <img class=\"mrgn-rght-sm service-icon\" src=\"/content/dam/dia-aid/icon-land.png\" alt=\"\"><h3 class=\"mrgn-tp-sm h5\">Land</h3>\n                        </div>\n                        <p>Upgrading vehicles, gear and infrastructure to keep the Army mobile, safe and ready for new challenges</p>\n                    </div>\n                </a>\n            </div>\n        </div><a class=\"rounded-white-btn mrgn-tp-sm mrgn-bttm-xl\" href=\"/en/defence-investment-agency/programs/projects-partnerships.html\" role=\"button\">More on projects and partnerships</a>\n    </div>\n</div>\n<div class=\"gradient-bg\">\n    <div class=\"container\">\n        <div class=\"row\">\n            <div class=\"col-md-4\">\n                <h2 class=\"h4 mrgn-tp-xl\"><a class=\"white-link\" href=\"/en/defence-investment-agency/corporate/leadership.html\">Leadership</a></h2>\n                <p class=\"white-text mrgn-bttm-xl\">Details about the people leading the Defence Investment Agency, including the Chief Executive Officer and the Secretary of State for Defence Procurement</p>\n            </div>\n            <div class=\"col-md-4\">\n                <h2 class=\"h4 mrgn-tp-xl\"><a class=\"white-link\" href=\"/en/defence-investment-agency/services/defence-procurement-outcomes.html\">Defence procurement outcomes</a></h2>\n                <p class=\"white-text mrgn-bttm-xl\">Optimizing and speeding up defence procurement by cutting through delays and delivering essential equipment and services faster</p>\n            </div>\n            <div class=\"col-md-4\">\n                <h2 class=\"h4 mrgn-tp-xl\"><a class=\"white-link\" href=\"/en/department-national-defence/corporate/policies-standards/our-north-strong-free-renewed-vision-canada-defence.html\">Canada’s defence policy</a></h2>\n                <p class=\"white-text mrgn-bttm-xl\">Outlining Canada’s renewed defence vision for the North, this strategy highlights key priorities to protect sovereignty, enhance security and support northern communities</p>\n            </div>\n        </div>\n    </div>\n</div>\n<div class=\"content-section\">\n    <div class=\"container\">\n        <div class=\"row wb-eqht-grd\">\n            <div class=\"col-md-6 hght-inhrt\">\n                <h2><img class=\"mrgn-rght-sm service-icon\" src=\"/content/dam/dia-aid/icon-news.png\" alt=\"\"> News</h2>\n<section class=\"wb-feeds wb-init wb-feeds-inited\" id=\"wb-auto-4\"><ul class=\"feeds-cont list-unstyled lst-spcd\"><li><a href=\"https://api.io.canada.ca/io-server/gc/news/en/v2?dept=defenceinvestmentagency&amp;sort=publishedDate&amp;orderBy=desc&amp;publishedDate%3E=2021-07-23&amp;pick=3&amp;format=atom&amp;atomtitle=Defense%20Investment%20Agency\" id=\"wb-auto-5\">Defence Investment Agency news releases</a></li>\n            </ul></section><p>More: <a href=\"/en/defence-investment-agency/corporate/news.html\">Defence Investment Agency news</a></p>\n                <div class=\"gc-followus content-section mrgn-tp-lg\">\n                    <h2>On social media</h2>\n                    <ul class=\"list-inline\"><li>\n                            <a href=\"https://www.facebook.com/DefenceInvestmentAgency/\" class=\"facebook\"><span class=\"wb-inv\">Facebook: </span>DefenceInvestmentAgency</a>\n                        </li>\n                        <li>\n                            <a href=\"https://x.com/DIA_Canada\" rel=\"external\" class=\"x-social\"><span class=\"wb-inv\">X: </span>@DIA_Canada</a>\n                        </li>\n                        <li>\n                            <a href=\"https://www.linkedin.com/company/defence-investment-agency-agence-de-l%E2%80%99investissement-pour-la-d%C3%A9fense\" rel=\"external\" class=\"linkedin\"><span class=\"wb-inv\">LinkedIn: </span>Defence Investment Agency || Agence de l’investissement pour la défense</a>\n                        </li>\n                    </ul></div>\n            </div>\n            <div class=\"col-md-6 hght-inhrt\">\n                <div class=\"bg-image-panel\">\n                    <img class=\"logo-small\" alt=\"\" src=\"/content/dam/dia-aid/dia-logo-eng.png\"><h2 class=\"wb-inv\">Our goal</h2>\n                    <p class=\"mrgn-tp-md\">Our goal is to modernize, simplify and make defence procurement more efficient, ensuring faster delivery without compromising accountability.</p>\n<p>These efforts ensure our defence forces remain ready to protect Canadians, strengthen sovereignty and meet international commitments, while supporting innovation and economic resilience.</p>\n<p><a href=\"/en/defence-investment-agency/corporate/about.html\">Learn more about us</a></p>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n\n</div>\n<div class=\"mwsmediaplayer section\">\n\n    <script>\nfunction openMobileMenu() {\n  var links = document.getElementById(\"dia-menu\");\n  if (links.style.display === \"block\") {\n    links.style.display = \"none\";\n  } else {\n    links.style.display = \"block\";\n  }\n}\n</script></div>"
