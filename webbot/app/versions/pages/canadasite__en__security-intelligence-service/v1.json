  "content": "<div class=\"mwstitle section\">\n\n    <h1 property=\"name\" id=\"wb-cont\" dir=\"ltr\">\nCanadian Security Intelligence Service</h1>\n\t</div>\n<div class=\"mwsalerts section\">\n\n\n\t\n\t\t\n\n\n\t\n\n\n\n<div class=\"alert \">\n\t\n</div>\n\n\t\n\n</div>\n<div class=\"mwscolumns section\">\n\n    <div class=\"row row\">\n        \n            <div class=\"col-sm-9 pull-left\">\n                <div class=\"mwsbodytext text parbase section\">\n    \n\n    \n        <p><strong>Our vision</strong>: A safe, secure and prosperous Canada, through trusted intelligence and advice.</p>\n<p><abbr>CSIS</abbr> is at the forefront of Canada's national security system. Our role is to investigate activities suspected of constituting threats to the security of Canada and to report on these to the Government of Canada. We may also take measures to reduce threats to the security of Canada in accordance with well-defined legal requirements and Ministerial Direction.</p>\n\n    \n\n\n</div>\n<div class=\"mwsbodytext text parbase section\">\n\n</div>\n\n\n            </div>\n        \n            <div class=\"col-sm-3 pull-right\">\n                <div class=\"mwscolumns section\">\n\n    <div class=\"row row\">\n        \n            <div class=\"col-xs-12 col-md-auto pull-right\">\n                <div class=\"mwsfollowus section\">\n\n\n\n    <section class=\"followus mrgn-tp-md wb-init followus-inited\" id=\"wb-auto-4\"><h2>Follow:</h2>\n        <ul><li><a rel=\"external\" class=\"facebook\" href=\"https://www.facebook.com/csiscanada/\"><span class=\"wb-inv\">Facebook</span></a></li>\n            <li><a rel=\"external\" class=\"twitter\" href=\"https://twitter.com/csiscanada\"><span class=\"wb-inv\">X</span></a></li>\n            <li><a rel=\"external\" class=\"youtube\" href=\"https://www.youtube.com/user/csisscrs\"><span class=\"wb-inv\">YouTube</span></a></li>\n            \n            \n            \n            <li><a rel=\"external\" class=\"linkedin\" hre