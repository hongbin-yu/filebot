<!DOCTYPE html>
<html class="no-js" lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>WebBot Page Editor</title>
    
    <!-- Canada.ca WET theme CSS -->
    <link rel="stylesheet" href="https://www.canada.ca/etc/designs/canada/wet-boew/css/theme.min.css">
    <link rel="stylesheet" href="https://www.canada.ca/etc/designs/canada/wet-boew/css/wet-boew.min.css">
    
    <!-- Simple custom styles -->
    <style>
        /* Hide Canada.ca default header/footer elements */
        #wb-bnr, #wb-sm, #wb-info, #wb-srch, #wb-lng, .wb-srch, .gcweb-menu, #gcwu-sig {
            display: none !important;
        }
        
        /* Simple container */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        
        .header {
            background: white;
            padding: 20px;
            border-bottom: 1px solid #ddd;
            margin-bottom: 20px;
            border-radius: 4px;
        }
        
        .header h1 {
            margin: 0 0 10px 0;
            color: #333;
        }
        
        .page-info {
            color: #666;
            font-size: 14px;
            margin-bottom: 5px;
        }
        
        /* Navigation links */
        .nav-links {
            margin-bottom: 20px;
        }
        
        .nav-links a {
            color: #007bff;
            text-decoration: none;
            margin-right: 15px;
        }
        
        .nav-links a:hover {
            text-decoration: underline;
        }
        
        /* Editor panel */
        .editor-panel {
            background: white;
            border-radius: 4px;
            border: 1px solid #ddd;
            padding: 20px;
            margin-bottom: 20px;
        }
        
        .editor-header {
            border-bottom: 1px solid #ddd;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }
        
        .editor-header h2 {
            margin: 0;
            color: #333;
            font-size: 20px;
        }
        
        /* Form elements */
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-group label {
            display: block;
            font-weight: 500;
            margin-bottom: 5px;
            color: #333;
        }
        
        .form-control {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 14px;
            box-sizing: border-box;
        }
        
        textarea.form-control {
            min-height: 400px;
            font-family: monospace;
            line-height: 1.5;
            resize: vertical;
        }
        
        /* Button group */
        .button-group {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }
        
        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            transition: background-color 0.2s;
        }
        
        .btn-primary {
            background-color: #007bff;
            color: white;
        }
        
        .btn-primary:hover {
            background-color: #0056b3;
        }
        
        .btn-secondary {
            background-color: #6c757d;
            color: white;
        }
        
        .btn-secondary:hover {
            background-color: #545b62;
        }
        
        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        
        /* Status messages */
        .loading {
            text-align: center;
            padding: 40px;
            color: #555;
        }
        
        .error {
            background: #f2dede;
            color: #a94442;
            padding: 15px;
            border-radius: 4px;
            margin: 15px 0;
            border: 1px solid #ebccd1;
        }
        
        .success {
            background: #d4edda;
            color: #155724;
            padding: 15px;
            border-radius: 4px;
            margin: 15px 0;
            border: 1px solid #c3e6cb;
        }
        
        /* Spinner animation for saving indicator */
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        .spinning {
            animation: spin 1s linear infinite;
            display: inline-block;
            margin-right: 8px;
        }
    </style>
</head>
<body vocab="http://schema.org/" resource="#wb-webpage" typeof="WebPage">
    <div class="container">
        <div class="header">
            <h1>WebBot Page Editor</h1>
            <div class="nav-links">
                <a href="navigation.html">← Back to Page Navigation</a>
            </div>
        </div>
        
        <div class="editor-panel">
            <div id="loading" class="loading">Loading page data...</div>
            <div id="error" class="error" style="display: none;"></div>
            <div id="success" class="success" style="display: none;"></div>
            
            <div id="editor-content" style="display: none;">
                <div class="editor-header">
                    <h2>Edit Page: <span id="page-title-display"></span></h2>
                    <div class="page-info">
                        Page ID: <span id="page-id-display"></span> | 
                        Language: <span id="page-language-display"></span> | 
                        Status: <span id="page-status-display"></span>
                    </div>
                </div>
                
                <form id="page-form">
                    <div class="form-group">
                        <label for="page-title">Page Title</label>
                        <input type="text" id="page-title" class="form-control" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="page-content">Page Content (HTML)</label>
                        <textarea id="page-content" class="form-control" required></textarea>
                    </div>
                    
                    <div class="button-group">
                        <button type="submit" id="save-btn" class="btn btn-primary">
                            <span id="save-spinner" class="spinning" style="display: none;"></span>
                            Save Changes
                        </button>
                        <button type="button" id="cancel-btn" class="btn btn-secondary">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Canada.ca WET theme JS -->
    <script src="https://www.canada.ca/etc/designs/canada/wet-boew/js/wet-boew.min.js"></script>
    <script src="https://www.canada.ca/etc/designs/canada/wet-boew/js/theme.min.js"></script>
    
    <!-- Simple editor logic -->
    <script>
        const API_BASE = '/api/v1/pages';
        let currentPageId = null;
        let originalData = null;
        
        // Get page ID from URL parameters
        function getPageIdFromUrl() {
            const params = new URLSearchParams(window.location.search);
            return params.get('pageId');
        }
        
        // Load page data on startup
        document.addEventListener('DOMContentLoaded', async () => {
            currentPageId = getPageIdFromUrl();
            
            if (!currentPageId) {
                showError('No page ID specified. Please select a page from the navigation.');
                return;
            }
            
            try {
                const response = await fetch(`${API_BASE}/${encodeURIComponent(currentPageId)}`);
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
                const pageData = await response.json();
                
                // Store original data
                originalData = pageData;
                
                // Hide loading, show editor
                document.getElementById('loading').style.display = 'none';
                document.getElementById('editor-content').style.display = 'block';
                
                // Populate form
                populateForm(pageData);
            } catch (error) {
                document.getElementById('loading').style.display = 'none';
                showError(`Failed to load page data: ${error.message}`);
                console.error('Error loading page:', error);
            }
            
            // Setup event listeners
            setupEventListeners();
        });
        
        // Populate form with page data
        function populateForm(pageData) {
            // Display info
            document.getElementById('page-title-display').textContent = pageData.title || pageData.id;
            document.getElementById('page-id-display').textContent = pageData.id;
            document.getElementById('page-language-display').textContent = pageData.language || 'en';
            document.getElementById('page-status-display').textContent = pageData.status || 'draft';
            
            // Form fields
            document.getElementById('page-title').value = pageData.title || '';
            document.getElementById('page-content').value = pageData.content || '';
        }
        
        // Setup event listeners
        function setupEventListeners() {
            // Form submission
            document.getElementById('page-form').addEventListener('submit', async (e) => {
                e.preventDefault();
                await savePage();
            });
            
            // Cancel button
            document.getElementById('cancel-btn').addEventListener('click', () => {
                if (confirm('Discard changes and return to navigation?')) {
                    window.location.href = 'navigation.html';
                }
            });
        }
        
        // Save page changes
        async function savePage() {
            const saveBtn = document.getElementById('save-btn');
            const saveSpinner = document.getElementById('save-spinner');
            const titleInput = document.getElementById('page-title');
            const contentInput = document.getElementById('page-content');
            
            // Validate
            if (!titleInput.value.trim()) {
                showError('Page title is required.');
                return;
            }
            
            if (!contentInput.value.trim()) {
                showError('Page content is required.');
                return;
            }
            
            // Prepare data
            const updateData = {
                title: titleInput.value.trim(),
                content: contentInput.value.trim(),
                // Keep other fields unchanged
                language: originalData.language,
                status: originalData.status,
                parent_id: originalData.parent_id
            };
            
            // Show saving state
            saveBtn.disabled = true;
            saveSpinner.style.display = 'inline-block';
            saveBtn.innerHTML = '<span class="spinning"></span> Saving...';
            
            try {
                const response = await fetch(`${API_BASE}/${encodeURIComponent(currentPageId)}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(updateData)
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
                
                // Update original data
                originalData = { ...originalData, ...updateData };
                
                // Show success message
                showSuccess('Page saved successfully.');
                
                // Update display
                document.getElementById('page-title-display').textContent = updateData.title;
                
            } catch (error) {
                showError(`Failed to save page: ${error.message}`);
                console.error('Error saving page:', error);
            } finally {
                // Restore button state
                saveBtn.disabled = false;
                saveSpinner.style.display = 'none';
                saveBtn.innerHTML = 'Save Changes';
            }
        }
        
        // Show error message
        function showError(message) {
            const errorEl = document.getElementById('error');
            errorEl.textContent = message;
            errorEl.style.display = 'block';
            
            // Hide success message if showing
            document.getElementById('success').style.display = 'none';
            
            // Auto-hide after 10 seconds
            setTimeout(() => {
                errorEl.style.display = 'none';
            }, 10000);
        }
        
        // Show success message
        function showSuccess(message) {
            const successEl = document.getElementById('success');
            successEl.textContent = message;
            successEl.style.display = 'block';
            
            // Hide error message if showing
            document.getElementById('error').style.display = 'none';
            
            // Auto-hide after 5 seconds
            setTimeout(() => {
                successEl.style.display = 'none';
            }, 5000);
        }
    </script>
</body>
</html>