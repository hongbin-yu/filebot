        // Load a specific page
        async function loadPage(pageIdOrPath, forcePathMode = false) {
            console.log('=== loadPage START ===');
            console.log('loadPage called with:', pageIdOrPath, 'type:', typeof pageIdOrPath, 'length:', pageIdOrPath.length, 'forcePathMode:', forcePathMode);
            console.log('Character codes:', Array.from(pageIdOrPath).map(c => c.charCodeAt(0)));
            // Determine if the input is a path (contains '/') or a page ID
            // Use forcePathMode if provided, otherwise auto-detect based on string
            const isPath = forcePathMode || pageIdOrPath.includes('/');
            console.log('isPath:', isPath, 'forcePathMode:', forcePathMode, 'pageIdOrPath.includes("/"):', pageIdOrPath.includes('/'), 'startsWith("/"):', pageIdOrPath.startsWith('/'));
            let apiUrl;
            let normalizedPath = pageIdOrPath;
            
            if (isPath) {
                // Normalize the path: ensure it starts with '/', remove trailing slash unless root
                if (!normalizedPath.startsWith('/')) {
                    normalizedPath = '/' + normalizedPath;
                }
                if (normalizedPath.endsWith('/') && normalizedPath !== '/') {
                    normalizedPath = normalizedPath.slice(0, -1);
                }
                apiUrl = `${API_BASE}/by-path?path=${encodeURIComponent(normalizedPath)}`;
                console.log('Path mode - normalizedPath:', normalizedPath, 'apiUrl:', apiUrl);
            } else {
                // It's a page ID
                apiUrl = `${API_BASE}/${encodeURIComponent(pageIdOrPath)}`;
                console.log('ID mode - pageIdOrPath:', pageIdOrPath, 'apiUrl:', apiUrl);
            }
            
            currentPageId = pageIdOrPath;

            // Show loading, hide other content
            showLoading();

            try {
                console.log('Fetching API:', apiUrl);
                const response = await fetch(apiUrl);
                console.log('API Response status:', response.status, response.statusText);
                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('API Error response:', errorText);
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
                const page = await response.json();
                console.log('API Success, page data received:', page.id, 'parent_id:', page.parent_id);

                // Store page data
                currentPageData = page;
                // Update currentPageId to actual page ID (not path)
                currentPageId = page.id;

                // Update breadcrumb in third line
                updateBreadcrumbFromCurrentPage();

                // Get page full path
                const pagePath = await getPageFullPath(page);
                
                // Update display
                pageTitleDisplayEl.textContent = page.title || 'Untitled';
                pageIdDisplayEl.textContent = ` | Path: ${pagePath}`;
                pageLanguageDisplayEl.textContent = ` | Language: ${page.language ? page.language.toUpperCase() : 'EN'}`;
                pageStatusDisplayEl.textContent = ` | Status: ${page.status || 'draft'}`;

                // Clean the page content to remove header/footer before editing
                const cleanedContent = cleanContent(page.content || '', page.id);

                // Populate form with cleaned content
                editorContentEl.value = cleanedContent;

                // Also populate TinyMCE editor if initialized
                if (tinyMceEditor) {
                    tinyMceEditor.setContent(cleanedContent);
                }

                // Update page content in currentPageData to cleaned version
                page.content = cleanedContent;

                // Show editor and actions, hide other states
                hideLoading();
                editorFormEl.style.display = 'block';
                editorActionsEl.style.display = 'block';
                noPageSelectedEl.style.display = 'none';
                errorAreaEl.style.display = 'none';
                successMessageEl.style.display = 'none';

                // Update URL without reloading
                const url = new URL(window.location);
                if (isPath) {
                    // For path-based loading, set path parameter to normalized path
                    url.searchParams.set('path', normalizedPath);
                    // Remove pageId parameter for cleaner URL when using path
                    url.searchParams.delete('pageId');
                } else {
                    // For ID-based loading, set pageId and path (if not already set)
                    url.searchParams.set('pageId', page.id);
                    if (!url.searchParams.has('path')) {
                        url.searchParams.set('path', page.id);
                    }
                }
                window.history.replaceState({}, '', url);

                console.log(`Loaded page: ${page.title} (via ${isPath ? 'path' : 'ID'}: ${pageIdOrPath})`);

                // Check if autoPreview is requested
                const urlParams = new URLSearchParams(window.location.search);
                if (urlParams.get('autoPreview') === 'true') {
                    // Remove autoPreview from URL to avoid repeated triggers
                    const url = new URL(window.location);
                    url.searchParams.delete('autoPreview');
                    window.history.replaceState({}, '', url);

                    // Trigger preview after a short delay to ensure UI is ready
                    setTimeout(() => {
                        previewPage();
                    }, 500);
                }
            } catch (error) {
                console.error('Error loading page:', error);
                showError(`Failed to load page: ${error.message}`);
            }
        }

        // Get full page path by recursively fetching parent pages
        async function getPageFullPath(page) {
            try {
                // Build URL path using page IDs (not titles)
                const idParts = [page.id];
                let currentPage = page;
                
                // Recursively fetch parent pages to build the hierarchy
                while (currentPage.parent_id) {
                    try {
                        // Fetch parent page by ID
                        const parentResponse = await fetch(`${API_BASE}/${encodeURIComponent(currentPage.parent_id)}`);
                        if (parentResponse.ok) {
                            const parentPage = await parentResponse.json();
                            // Add parent ID to beginning of path
                            idParts.unshift(parentPage.id);
                            currentPage = parentPage;
                        } else {
                            // If parent not found, add parent ID as placeholder
                            idParts.unshift(currentPage.parent_id);
                            break;
                        }
                    } catch (error) {
                        console.error('Error fetching parent page:', error);
                        // Add parent ID as placeholder
                        idParts.unshift(currentPage.parent_id);
                        break;
                    }
                    
                    // Safety check: avoid infinite loop
                    if (idParts.length > 10) {
                        console.warn('Path depth exceeds safety limit, stopping recursion');
                        break;
                    }
                }
                
                // Join ID parts with "/" separator and add leading "/"
                return '/' + idParts.join('/');
            } catch (error) {
                console.error('Error getting page path:', error);
                // Fallback to just showing the page ID
                return page.id;
            }
        }

