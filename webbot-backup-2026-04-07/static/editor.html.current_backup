            preloadFileManagerModal();
            
            // Load files into file manager panel if it's visible
            const fileManagerPanel = document.getElementById('file-manager-panel');
            if (fileManagerPanel && !fileManagerPanel.classList.contains('hidden')) {
                console.log('File manager panel is visible, loading files...');
                setTimeout(() => {
                    loadFilesToPanel().catch(err => {
                        console.error('Failed to load files to panel:', err);
                    });
                }, 1000); // Wait 1 second for everything to initialize
            }

            // Add event listeners for editor mode switching
            editorModeBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    const mode = this.getAttribute('data-mode');
                    switchEditorMode(mode);
                });
            });
        });

