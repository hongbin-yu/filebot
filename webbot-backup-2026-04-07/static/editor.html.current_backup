            // Relocate breadcrumb elements to the designated container (third line)
            function relocateBreadcrumbs() {
                const breadcrumbSelectors = [
                    '.wb-breadcrumb', '.breadcrumb', '[aria-label*="Breadcrumb"]',
                    '[aria-label*="breadcrumb"]', '[aria-label*="fil d\'ariane"]',
                    'nav[role="navigation"]', 'nav[role="breadcrumb"]',
                    '.gc-breadcrumb', '.gc-breadcrumbs', '.fil-ariane', '.fil-dariane',
                    '.wet-boew-breadcrumb', '.canada-breadcrumb', '.wb-navcurr',
                    'ol.breadcrumb', 'ul.wb-breadcrumb', 'ul.breadcrumb',
                    '#breadcrumb', '.nav-breadcrumb', '.bc', '.breadcrumbs',
                    // Common GCWeb selectors
                    '#wb-bc', '.wb-bc', '#wb-bc-in', '.wb-bc-in',
                    // Avoid our own container
                ];
                
                const breadcrumbContainer = document.getElementById('breadcrumb-container');
                if (!breadcrumbContainer) {
                    console.error('Breadcrumb container not found!');
                    return;
                }
                
                // Make sure our container is visible
                breadcrumbContainer.style.display = 'block';
                
                // Clear existing content in breadcrumb container
                const existingBreadcrumb = breadcrumbContainer.querySelector('.breadcrumb');
                if (existingBreadcrumb && existingBreadcrumb.children.length > 0) {
                    // Keep default breadcrumb if no real breadcrumb found
                    console.log('Breadcrumb container already has content, keeping it');
                } else {
                    breadcrumbContainer.innerHTML = '<nav aria-label="Breadcrumb" class="breadcrumb"></nav>';
                    console.log('Initialized empty breadcrumb container');
                }
                
                const breadcrumbNav = breadcrumbContainer.querySelector('.breadcrumb');
                
                // Look for breadcrumb elements in the document
                let foundBreadcrumb = null;
                let foundSelector = null;
                
                console.log('Looking for breadcrumbs with', breadcrumbSelectors.length, 'selectors');
                breadcrumbSelectors.forEach(selector => {
                    if (foundBreadcrumb) return; // Already found one
                    
                    const elements = document.querySelectorAll(selector);
                    console.log(`Selector "${selector}" found ${elements.length} elements`);
                    
                    elements.forEach(el => {
                        // Skip if element is inside our container
                        if (breadcrumbContainer.contains(el)) {
                            console.log(`Skipping element inside our container: ${selector}`);
                            return;
                        }
                        
                        // Check if this looks like a real breadcrumb (has links or list items)
                        const hasLinks = el.querySelector('a');
                        const hasListItems = el.querySelector('li');
                        const hasText = el.textContent.trim();
                        
                        if (hasLinks || hasListItems || hasText) {
                            foundBreadcrumb = el;
                            foundSelector = selector;
                            console.log(`Found breadcrumb with selector "${selector}":`, el);
                            console.log(`- Has links: ${hasLinks ? 'yes' : 'no'}`);
                            console.log(`- Has list items: ${hasListItems ? 'yes' : 'no'}`);
                            console.log(`- Has text: ${hasText ? 'yes (' + hasText.length + ' chars)' : 'no'}`);
                        }
                    });
                });
                
                if (foundBreadcrumb) {
                    console.log(`Found breadcrumb element with selector "${foundSelector}":`, foundBreadcrumb);
                    console.log('Breadcrumb HTML:', foundBreadcrumb.outerHTML);
                    
                    // Move the entire breadcrumb element into our container
                    breadcrumbNav.innerHTML = '';
                    
                    // Clone the breadcrumb content
                    const breadcrumbContent = foundBreadcrumb.cloneNode(true);
                    
                    // Ensure it has proper classes
                    breadcrumbContent.classList.remove('wb-breadcrumb', 'gc-breadcrumb', 'wb-navcurr');
                    breadcrumbContent.classList.add('breadcrumb');
                    
                    // Set ARIA attributes
                    breadcrumbContent.setAttribute('aria-label', 'Breadcrumb');
                    
                    // Append to our container
                    breadcrumbNav.appendChild(breadcrumbContent);
                    
                    // Remove the original breadcrumb from its default location
                    foundBreadcrumb.remove();
                    
                    console.log('Breadcrumb relocated to container at third line');
                    
                    // Also hide any parent containers that might still show
                    const parentContainers = foundBreadcrumb.parentNode;
                    if (parentContainers && (parentContainers.classList.contains('wb-bc') || parentContainers.id === 'wb-bc')) {
                        parentContainers.style.display = 'none';
                        console.log('Also hid parent breadcrumb container:', parentContainers);
                    }
                } else {
                    // No breadcrumb found, create a simple one based on current page
                    console.log('No external breadcrumb found, creating default breadcrumb for current page');
                    updateBreadcrumbFromCurrentPage();
                }
            }
            
            // Make relocateBreadcrumbs available globally for WET-BOEW initialization
            window.relocateBreadcrumbs = relocateBreadcrumbs;
            
            // Update breadcrumb based on current page data
            function updateBreadcrumbFromCurrentPage() {
                const breadcrumbContainer = document.getElementById('breadcrumb-container');
                if (!breadcrumbContainer) return;
                
                const breadcrumbNav = breadcrumbContainer.querySelector('.breadcrumb');
                if (!breadcrumbNav) return;
                
                if (currentPageId && currentPageData) {
                    // Create breadcrumb based on page hierarchy
                    let breadcrumbHtml = '';
                    
                    // Home link
                    breadcrumbHtml += '<li class="breadcrumb-item"><a href="#" onclick="clearEditor(); return false;">Home</a></li>';
                    
                    // Parent pages if available
                    if (currentPageData.parent_id && currentPageData.parent_id !== 'root') {
                        breadcrumbHtml += `<li class="breadcrumb-item"><a href="#" onclick="loadPage('${currentPageData.parent_id}'); return false;">${currentPageData.parent_id}</a></li>`;
                    }
                    
                    // Current page (active)
                    breadcrumbHtml += `<li class="breadcrumb-item active" aria-current="page">${currentPageData.title || currentPageId}</li>`;
                    
                    breadcrumbNav.innerHTML = breadcrumbHtml;
                } else {
                    // Default breadcrumb
                    breadcrumbNav.innerHTML = `
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item"><a href="#">Pages</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Select a page</li>
                    `;
                }
            }
            
            // Make updateBreadcrumbFromCurrentPage available globally
            window.updateBreadcrumbFromCurrentPage = updateBreadcrumbFromCurrentPage;
            
            // Run immediately and also after a delay to catch dynamically added breadcrumbs
            relocateBreadcrumbs();
            setTimeout(relocateBreadcrumbs, 1000);
            setTimeout(relocateBreadcrumbs, 3000);
            
            // Mutation Observer to watch for dynamically added breadcrumb elements
            function setupBreadcrumbObserver() {
                const observer = new MutationObserver((mutations) => {
                    mutations.forEach((mutation) => {
                        if (mutation.addedNodes && mutation.addedNodes.length > 0) {
                            // Check if any added nodes or their children are breadcrumbs
                            mutation.addedNodes.forEach((node) => {
                                if (node.nodeType === Node.ELEMENT_NODE) {
                                    relocateBreadcrumbs();
                                }
                            });
                        }
                    });
                });
                
                observer.observe(document.body, {
                    childList: true,
                    subtree: true
                });
                
                return observer;
            }
            
            // Setup observer
            setupBreadcrumbObserver();

            // Get page ID from URL if present
            const urlParams = new URLSearchParams(window.location.search);
            const pageIdFromUrl = urlParams.get('pageId');
            let pathFromUrl = urlParams.get('path');
            console.log('Raw pathFromUrl from URLSearchParams:', pathFromUrl, 'typeof:', typeof pathFromUrl);
            console.log('Full URL:', window.location.href);
            console.log('URL search string:', window.location.search);
            
            // Ensure path is properly decoded (URLSearchParams should do this, but be safe)
            if (pathFromUrl) {
                console.log('Before decoding - pathFromUrl:', pathFromUrl, 'length:', pathFromUrl.length, 'charCodeAt[0]:', pathFromUrl.charCodeAt(0));
                try {
                    // Try additional decoding just in case
                    const decodedPath = decodeURIComponent(pathFromUrl);
                    console.log('decodeURIComponent result:', decodedPath, 'same as original?', decodedPath === pathFromUrl);
                    if (decodedPath !== pathFromUrl) {
                        console.log('Additional decoding changed path:', pathFromUrl, '→', decodedPath);
                        pathFromUrl = decodedPath;
                    }
                } catch (e) {
                    console.warn('Failed to decode path:', e);
                }
                
                console.log('After decoding - pathFromUrl:', pathFromUrl, 'startsWith("/"):', pathFromUrl.startsWith('/'), 'includes("/"):', pathFromUrl.includes('/'));
                
                // Fix path if it's missing leading slash
                if (!pathFromUrl.startsWith('/')) {
                    console.log('Path missing leading slash, checking if it looks like a path');
                    // If it contains a slash, it's likely a path missing the leading slash
                    if (pathFromUrl.includes('/')) {
                        console.log('Fixing path: adding leading slash to', pathFromUrl);
                        pathFromUrl = '/' + pathFromUrl;
                    } else {
                        console.log('Path does not contain slash, treating as simple ID:', pathFromUrl);
                    }
                }
                console.log('Final pathFromUrl:', pathFromUrl);
            }
            
            // Check for path suffix in URL (e.g., /static/editor.html/en/contact)
            let pathFromPathname = null;
            const pathname = window.location.pathname;
            const editorHtmlIndex = pathname.indexOf('/editor.html/');
            if (editorHtmlIndex !== -1) {
                // Extract everything after '/editor.html/'
                pathFromPathname = pathname.substring(editorHtmlIndex + '/editor.html'.length);
                console.log(`Detected path suffix: "${pathFromPathname}"`);
                
                // Clean URL: remove redundant query parameters when using path suffix mode
                if (urlParams.has('pageId') || urlParams.has('path')) {
                    const cleanUrl = new URL(window.location);
                    cleanUrl.searchParams.delete('pageId');
                    cleanUrl.searchParams.delete('path');
                    window.history.replaceState({}, '', cleanUrl);
                    console.log('Cleaned URL: removed redundant query parameters (pageId, path)');
                }
            }
            
            // Helper function to resolve a URL path to a page ID - DEPRECATED, use /by-path API instead
            // This function is kept for backward compatibility but should not be used for new code
            function resolvePathToPageId(path) {
                console.warn('DEPRECATED: resolvePathToPageId called with:', path);
                if (!path) return "";
                
                console.log(`Resolving path: "${path}"`);
                
                // Remove leading and trailing slashes
                let cleanPath = path.trim();
                if (cleanPath.startsWith('/')) {
                    cleanPath = cleanPath.slice(1);
                }
                if (cleanPath.endsWith('/')) {
                    cleanPath = cleanPath.slice(0, -1);
                }
                
                // If path is empty or root, return empty
                if (!cleanPath || cleanPath === '/') {
                    return "";
                }
                
                // Split path into components
                const parts = cleanPath.split('/');
                
                // Get the last part (page name)
                let pageName = parts[parts.length - 1];
                
                // Simple plural to singular conversion
                if (pageName.endsWith('s') && pageName.length > 1) {
                    pageName = pageName.slice(0, -1);
                }
                
                // Special cases mapping
                const specialCases = {
                    'contacter': 'contact',  // French contact page
                    'contacts': 'contact',
                    'abouts': 'about',
                    'features': 'feature',
                    'initiatives': 'initiative',
                    'services': 'service',
                    'programs': 'program',
                    'programmes': 'programme',
                };
                
                // Check if we have a special case mapping
                const lowerName = pageName.toLowerCase();
                if (specialCases[lowerName]) {
                    console.log(`Special case mapping: "${pageName}" → "${specialCases[lowerName]}"`);
                    return specialCases[lowerName];
                }
                
                console.log(`Resolved path "${path}" → page ID: "${pageName}"`);
                return pageName;
            }
            
            // Determine which page to load
            let pageToLoad = null;
            let loadByPath = false;
            
            // Priority 1: path suffix in URL (e.g., /editor.html/en/contact)
            if (pathFromPathname) {
                pageToLoad = pathFromPathname;
                loadByPath = true;
                console.log(`Loading page by path suffix: "${pathFromPathname}"`);
            }
            // Priority 2: path parameter in query string
            else if (pathFromUrl) {
                pageToLoad = pathFromUrl;
                loadByPath = true;
                console.log(`Loading page by path parameter: "${pathFromUrl}"`);
                
                // Clean URL: remove pageId parameter when path is present
                if (urlParams.has('pageId')) {
                    const cleanUrl = new URL(window.location);
                    cleanUrl.searchParams.delete('pageId');
                    window.history.replaceState({}, '', cleanUrl);
                    console.log('Cleaned URL: removed pageId parameter');
                }
            }
            // Priority 3: pageId parameter
            else if (pageIdFromUrl) {
                pageToLoad = pageIdFromUrl;
                console.log(`Loading page by ID: "${pageIdFromUrl}"`);
            }
            
            // If page to load, load it
            if (pageToLoad) {
                setTimeout(() => {
                    loadPage(pageToLoad, loadByPath);
                }, 500);
            }

            // Event listeners
            previewPageBtn.addEventListener('click', previewPage);
            savePageBtn.addEventListener('click', savePage);
            cancelEditBtn.addEventListener('click', cancelEdit);
            // File manager button removed as per user request to test breadcrumb position - NOW RESTORED
            if (fileManagerBtn) {
