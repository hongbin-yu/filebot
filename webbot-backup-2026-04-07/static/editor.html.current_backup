                        const fileName = selectedFile.dataset.fileName;
                        const fileType = selectedFile.dataset.fileType;
                        
                        insertFileLink(fileId, fileName, fileType);
                        // Close the modal by clicking the close button
                        const closeBtn = document.querySelector('#file-manager-modal .overlay-close');
                        if (closeBtn) closeBtn.click();
                    }
                });
            }
            
            // Close modal handlers - WET-BOEW handles closing automatically for .overlay-close buttons
            // No need to add additional click handlers
        }
        
        // Load files from API
        function loadFiles() {
            fetch('/api/v1/files/')
                .then(response => response.json())
                .then(data => {
                    updateFileList(data.files || []);
                })
                .catch(error => {
                    console.error('Error loading files:', error);
                    updateFileList([]);
                });
        }
        
        // Update file list display (both modal and panel)
        function updateFileList(files) {
            // Update modal elements (original UI)
            const fileListBody = document.getElementById('file-list-body');
            const noFilesMessage = document.getElementById('no-files-message');
            const fileListTable = document.getElementById('file-list-table');
            const fileCount = document.getElementById('file-count');
            const insertBtn = document.getElementById('insert-selected-file');
            
            // Update panel elements (new left sidebar UI)
            const fmFileList = document.getElementById('fm-file-list');
            const fmNoFilesMessage = document.getElementById('fm-no-files-message');
            const fmFileCount = document.getElementById('fm-file-count');
            const fmInsertBtn = document.getElementById('fm-insert-selected-file');
            
            // Update file count in both UIs
            if (fileCount) {
                fileCount.textContent = files.length;
            }
            if (fmFileCount) {
                fmFileCount.textContent = files.length;
            }
            
            // Show/hide empty state for modal
            if (files.length === 0) {
                if (noFilesMessage) noFilesMessage.style.display = 'block';
                if (fileListTable) fileListTable.style.display = 'none';
                if (insertBtn) insertBtn.disabled = true;
                
                // Also update panel
                if (fmNoFilesMessage) fmNoFilesMessage.style.display = 'block';
                if (fmFileList) fmFileList.style.display = 'none';
                if (fmInsertBtn) fmInsertBtn.disabled = true;
                return;
            }
            
            // Show table in modal
            if (noFilesMessage) noFilesMessage.style.display = 'none';
            if (fileListTable) fileListTable.style.display = 'table';
            
            // Show list in panel
            if (fmNoFilesMessage) fmNoFilesMessage.style.display = 'none';
            if (fmFileList) fmFileList.style.display = 'block';
            
            // Clear existing rows in modal
            if (fileListBody) {
                fileListBody.innerHTML = '';
            }
            
            // Clear existing rows in panel
            if (fmFileList) {
                fmFileList.innerHTML = '';
            }
            
            // Add file rows to both UIs
            files.forEach(file => {
                // Format file data
                const fileSize = formatFileSize(file.size || 0);
                const uploadDate = new Date(file.uploaded_at || Date.now()).toLocaleDateString();
                const fileIcon = getFileIcon(file.type, file.name);
                const fileTypeLabel = getFileTypeLabel(file.type);
                
                // ===== MODAL UI (table rows) =====
                if (fileListBody) {
                    const modalRow = document.createElement('tr');
                    modalRow.dataset.fileId = file.id;
                    modalRow.dataset.fileName = file.name;
                    modalRow.dataset.fileType = file.type;
                    
                    modalRow.innerHTML = `
                        <td>
                            <span class="${fileIcon}" style="margin-right: 8px;"></span>
                            ${escapeHtml(file.name)}
                        </td>
                        <td>${fileTypeLabel}</td>
                        <td>${fileSize}</td>
                        <td>${uploadDate}</td>
                        <td>
                            <button class="btn btn-xs btn-info preview-file" data-file-id="${file.id}">
                                <span class="glyphicon glyphicon-eye-open"></span> Preview
                            </button>
                            <button class="btn btn-xs btn-primary insert-file" data-file-id="${file.id}">
                                <span class="glyphicon glyphicon-link"></span> Insert
                            </button>
                        </td>
                    `;
                    
                    // Add click handler for selection
                    modalRow.addEventListener('click', function(e) {
                        if (e.target.tagName === 'BUTTON' || e.target.closest('button')) return;
                        const selected = this.classList.toggle('selected');
                        document.querySelectorAll('#file-list-body tr').forEach(r => {
                            if (r !== this) r.classList.remove('selected');
                        });
                        if (insertBtn) insertBtn.disabled = !selected;
                    });
                    
                    // Action button handlers
                    modalRow.querySelector('.preview-file')?.addEventListener('click', function(e) {
                        e.stopPropagation();
                        previewFile(file.id);
                    });
                    
                    modalRow.querySelector('.insert-file')?.addEventListener('click', function(e) {
                        e.stopPropagation();
                        insertFileLink(file.id, file.name, file.type);
                        // Close the modal if open
                        const closeBtn = document.querySelector('#file-manager-modal .overlay-close');
                        if (closeBtn) closeBtn.click();
                    });
                    
                    fileListBody.appendChild(modalRow);
                }
                
                // ===== PANEL UI (cards) =====
                if (fmFileList) {
                    const panelCard = document.createElement('div');
                    panelCard.className = 'fm-file-card';
                    panelCard.dataset.fileId = file.id;
                    panelCard.dataset.fileName = file.name;
                    panelCard.dataset.fileType = file.type;
                    
                    panelCard.innerHTML = `
                        <div class="fm-file-card-header">
                            <span class="${fileIcon}" style="margin-right: 8px; font-size: 16px;"></span>
                            <strong class="fm-file-name">${escapeHtml(file.name)}</strong>
                        </div>
                        <div class="fm-file-card-body">
                            <div class="fm-file-info">
                                <span class="fm-file-type">${fileTypeLabel}</span>
                                <span class="fm-file-size">${fileSize}</span>
                                <span class="fm-file-date">${uploadDate}</span>
                            </div>
                            <div class="fm-file-actions">
                                <button class="btn btn-xs btn-info fm-preview-file" data-file-id="${file.id}">
                                    <span class="glyphicon glyphicon-eye-open"></span> Preview
                                </button>
                                <button class="btn btn-xs btn-primary fm-insert-file" data-file-id="${file.id}">
                                    <span class="glyphicon glyphicon-link"></span> Insert
                                </button>
                            </div>
                        </div>
                    `;
                    
                    // Add click handler for selection
                    panelCard.addEventListener('click', function(e) {
                        if (e.target.tagName === 'BUTTON' || e.target.closest('button')) return;
                        const selected = this.classList.toggle('selected');
                        // Only allow one selection at a time
                        document.querySelectorAll('.fm-file-card').forEach(card => {
                            if (card !== this) card.classList.remove('selected');
                        });
                        if (fmInsertBtn) fmInsertBtn.disabled = !selected;
                    });
                    
                    // Action button handlers
                    panelCard.querySelector('.fm-preview-file')?.addEventListener('click', function(e) {
                        e.stopPropagation();
                        previewFile(file.id);
                    });
                    
                    panelCard.querySelector('.fm-insert-file')?.addEventListener('click', function(e) {
                        e.stopPropagation();
                        insertFileLink(file.id, file.name, file.type);
                        // Hide the panel after insertion
                        const panel = document.getElementById('file-manager-panel');
                        if (panel) panel.classList.add('hidden');
                    });
                    
                    fmFileList.appendChild(panelCard);
                }
            });
            
            // Enable/disable insert buttons based on selection
            if (insertBtn) insertBtn.disabled = true;
            if (fmInsertBtn) fmInsertBtn.disabled = true;
        }
        
        // Upload files
        function uploadFiles(files) {
            const uploadProgress = document.getElementById('upload-progress');
            const progressBar = uploadProgress?.querySelector('.progress-bar');
            const uploadStatus = document.getElementById('upload-status');
            
            // Panel upload elements
            const fmUploadProgress = document.getElementById('fm-upload-progress');
            const fmProgressBar = fmUploadProgress?.querySelector('.progress-bar');
            const fmUploadStatus = document.getElementById('fm-upload-status');
            
            // Show progress in modal
            if (uploadProgress) uploadProgress.style.display = 'block';
            if (progressBar) {
                progressBar.style.width = '0%';
                progressBar.textContent = '0%';
            }
            if (uploadStatus) uploadStatus.textContent = 'Preparing upload...';
            
            // Show progress in panel
            if (fmUploadProgress) fmUploadProgress.style.display = 'block';
            if (fmProgressBar) {
                fmProgressBar.style.width = '0%';
                fmProgressBar.querySelector('.sr-only').textContent = '0% Complete';
            }
            if (fmUploadStatus) fmUploadStatus.textContent = 'Preparing upload...';
            
            // Upload each file
            Array.from(files).forEach((file, index) => {
                const formData = new FormData();
                formData.append('file', file);
                
                // Update status in modal
                if (uploadStatus) {
                    uploadStatus.textContent = `Uploading ${file.name} (${index + 1}/${files.length})`;
                }
                
                // Update status in panel
                if (fmUploadStatus) {
                    fmUploadStatus.textContent = `Uploading ${file.name} (${index + 1}/${files.length})`;
                }
                
                // 添加默认的文件夹ID到FormData
                // 使用FileBot中的第一个文件夹ID
                formData.append('folder_id', '831c35b2-8546-43b4-bba8-9e4100f9953f');
                
                fetch('/api/v1/files/upload', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    // Update progress in both UIs
                    const progress = Math.round(((index + 1) / files.length) * 100);
                    if (progressBar) {
                        progressBar.style.width = `${progress}%`;
                        progressBar.textContent = `${progress}%`;
                    }
                    if (fmProgressBar) {
                        fmProgressBar.style.width = `${progress}%`;
                        fmProgressBar.querySelector('.sr-only').textContent = `${progress}% Complete`;
                    }
                    
                    if (index === files.length - 1) {
                        // All files uploaded
                        if (uploadStatus) uploadStatus.textContent = 'Upload complete!';
                        if (fmUploadStatus) fmUploadStatus.textContent = 'Upload complete!';
                        
                        // Hide progress after delay
                        setTimeout(() => {
                            if (uploadProgress) uploadProgress.style.display = 'none';
                            if (fmUploadProgress) fmUploadProgress.style.display = 'none';
                        }, 2000);
                        
                        // Reload file list
                        loadFiles();
                    }
                })
                .catch(error => {
                    console.error('Upload error:', error);
                    // Update error status in both UIs
                    if (uploadStatus) {
                        uploadStatus.textContent = `Error uploading ${file.name}: ${error.message}`;
                        uploadStatus.style.color = '#d9534f';
                    }
                    if (fmUploadStatus) {
                        fmUploadStatus.textContent = `Error uploading ${file.name}: ${error.message}`;
                        fmUploadStatus.style.color = '#d9534f';
                    }
                });
            });
        }
        
        // Insert file link into editor
        function insertFileLink(fileId, fileName, fileType) {
            const editor = tinymce.activeEditor;
            if (!editor) return;
            
            // Generate appropriate HTML based on file type
            let html = '';
            if (fileType.startsWith('image/')) {
                // Image file - insert img tag
                const fileUrl = `/api/v1/files/${fileId}/download`;
                html = `<img src="${fileUrl}" alt="${escapeHtml(fileName)}" class="img-responsive">`;
            } else {
                // Other file - insert download link
                const fileUrl = `/api/v1/files/${fileId}/download`;
                html = `<a href="${fileUrl}" class="btn btn-default">
                    <span class="glyphicon glyphicon-download-alt"></span>
                    Download ${escapeHtml(fileName)}
                </a>`;
            }
            
            // Insert into editor
            editor.insertContent(html);
        }
        
        // Preview file (if supported)
        function previewFile(fileId) {
            // TODO: Implement file preview
            alert('File preview functionality will be implemented in Phase 2.');
        }
        
        // Helper functions
        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }
        
        function getFileIcon(fileType, fileName) {
            if (fileType.startsWith('image/')) {
                return 'glyphicon glyphicon-picture';
            } else if (fileType === 'application/pdf') {
                return 'glyphicon glyphicon-file';
            } else if (fileType.includes('word') || fileName.match(/\.docx?$/i)) {
                return 'glyphicon glyphicon-file';
            } else if (fileType.includes('excel') || fileName.match(/\.xlsx?$/i)) {
                return 'glyphicon glyphicon-list-alt';
            } else if (fileType.includes('powerpoint') || fileName.match(/\.pptx?$/i)) {
                return 'glyphicon glyphicon-blackboard';
            } else {
                return 'glyphicon glyphicon-file';
            }
        }
        
        function getFileTypeLabel(fileType) {
            if (fileType.startsWith('image/')) {
                return 'Image';
            } else if (fileType === 'application/pdf') {
                return 'PDF';
            } else if (fileType.includes('word')) {
                return 'Word';
            } else if (fileType.includes('excel')) {
                return 'Excel';
            } else if (fileType.includes('powerpoint')) {
                return 'PowerPoint';
            } else {
                return 'File';
            }
        }
        
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
        
        // ========== END FILE MANAGER FUNCTIONS ==========

        // Initialize WET-BOEW when ready
        function initializeWETBOEW() {
            console.log('Initializing WET-BOEW components');
            
            // Check if wb object exists (WET-BOEW loaded)
            if (typeof wb !== 'undefined') {
                console.log('WET-BOEW object found');
                
                // Listen for WET-BOEW ready event
                wb.doc.on('wb-ready.wb', function(event) {
                    console.log('WET-BOEW ready event fired - lightboxes and plugins initialized');
                    
                    // Re-run breadcrumb relocation after WET-BOEW initialization
                    // This ensures any breadcrumbs added by GCWeb theme are captured
                    console.log('WET-BOEW ready: relocating breadcrumbs');
                    if (typeof window.relocateBreadcrumbs === 'function') {
                        window.relocateBreadcrumbs();
                        // Also schedule additional checks
                        setTimeout(window.relocateBreadcrumbs, 500);
                        setTimeout(window.relocateBreadcrumbs, 1500);
                    }
                    
                    // If file manager modal already exists, reinitialize it
                    const fileManagerModal = document.getElementById('file-manager-modal');
                    if (fileManagerModal && wb && wb.init) {
                        console.log('Reinitializing file manager modal for WET-BOEW');
                        wb.init(fileManagerModal);
                    }
                });
            } else {
                console.log('WET-BOEW object not yet available, will retry');
                // Retry after a short delay
                setTimeout(initializeWETBOEW, 100);
            }
        }
        
