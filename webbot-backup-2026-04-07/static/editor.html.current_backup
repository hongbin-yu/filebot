        // ========== COMPONENT TEMPLATE SYSTEM ==========
        
        // Component templates configuration (cached)
        let componentTemplates = null;
        let templateConfigLoaded = false;
        
        /**
         * Load component templates configuration from JSON file
         */
        async function loadComponentTemplates() {
            if (templateConfigLoaded) {
                return componentTemplates;
            }
            
            try {
                const response = await fetch('/component-templates.json');
                if (!response.ok) {
                    throw new Error(`Failed to load templates: ${response.status}`);
                }
                componentTemplates = await response.json();
                templateConfigLoaded = true;
                console.log('Component templates loaded:', Object.keys(componentTemplates.templates || {}).length);
                return componentTemplates;
            } catch (error) {
                console.error('Error loading component templates:', error);
                // Fallback to empty config
                componentTemplates = { templates: {} };
                templateConfigLoaded = true;
                return componentTemplates;
            }
        }
        
        /**
         * Fetch component template from database or external URL
         */
        async function fetchComponentTemplate(componentType, params = {}) {
            // Load templates config if not already loaded
            await loadComponentTemplates();
            
            const templateConfig = componentTemplates.templates[componentType];
            
            if (!templateConfig) {
                console.warn(`No template config found for component type: ${componentType}`);
                return null;
            }
            
            try {
                let templateHtml = '';
                
                if (templateConfig.source === 'database') {
                    // Fetch from database template page
                    const response = await fetch(`${API_BASE}/pages/${encodeURIComponent(templateConfig.path)}`);
                    if (!response.ok) {
                        throw new Error(`Database template not found: ${response.status}`);
                    }
                    const pageData = await response.json();
                    templateHtml = pageData.content || '';
                    
                } else if (templateConfig.source === 'url') {
                    // Determine language based on current page or default to English
                    let language = 'en';
                    if (currentPageData && currentPageData.language) {
                        language = currentPageData.language;
                    }
                    
                    let fetchUrl = templateConfig.url;
                    
                    // Adjust URL for French language if needed
                    if (language === 'fr') {
                        // Handle wet-boew.github.io URLs (replace -en.html with -fr.html)
                        if (fetchUrl.includes('wet-boew.github.io') && fetchUrl.includes('-en.html')) {
                            fetchUrl = fetchUrl.replace('-en.html', '-fr.html');
                            console.log(`Using French template URL: ${fetchUrl}`);
                        }
                        // Note: design.canada.ca URLs don't have simple French equivalents
                        // so we keep the English URL for now
                    }
                    
                    // Fetch from external URL
                    const response = await fetch(fetchUrl);
                    if (!response.ok) {
                        // If French version fails, try English as fallback
                        if (language === 'fr' && fetchUrl !== templateConfig.url) {
                            console.log(`French template not available, trying English: ${templateConfig.url}`);
                            const fallbackResponse = await fetch(templateConfig.url);
                            if (!fallbackResponse.ok) {
                                throw new Error(`External template not found: ${fallbackResponse.status}`);
                            }
                            templateHtml = await fallbackResponse.text();
                        } else {
                            throw new Error(`External template not found: ${response.status}`);
                        }
                    } else {
                        templateHtml = await response.text();
                    }
                    
                } else {
                    console.error(`Unknown template source: ${templateConfig.source}`);
                    return null;
                }
                
                // Apply parameter substitution if provided
                if (params.buttonText && templateHtml.includes('${buttonText}')) {
                    templateHtml = templateHtml.replace(/\${buttonText}/g, params.buttonText);
                }
                
                // Add webbot-component class if not already present
                if (!templateHtml.includes('webbot-component')) {
                    // Simple heuristic: add class to the first HTML element
                    templateHtml = templateHtml.replace(/<([a-z][a-z0-9]*)([^>]*)>/i, 
                        (match, tag, attrs) => {
                            if (attrs.includes('class="')) {
                                return `<${tag}${attrs.replace('class="', 'class="webbot-component ')}>`;
                            } else {
                                return `<${tag} class="webbot-component"${attrs}>`;
                            }
                        });
                }
                
                return templateHtml;
                
            } catch (error) {
                console.error(`Error fetching template for ${componentType}:`, error);
                return null;
            }
        }
        
        /**
         * Insert component using template system (supports both hardcoded and fetched templates)
         */
        async function insertComponent(componentType, params = {}) {
            if (!tinyMceEditor) {
                console.error('TinyMCE editor not initialized');
                return false;
            }
            
            // First, try to fetch from template system
            let componentHtml = await fetchComponentTemplate(componentType, params);
            
            // If template fetch failed, fall back to hardcoded templates
            if (!componentHtml) {
                console.log(`Falling back to hardcoded template for: ${componentType}`);
                componentHtml = getHardcodedComponentHtml(componentType, params);
            }
            
            if (!componentHtml) {
                console.error(`No template found for component type: ${componentType}`);
                showError(`Component type "${componentType}" not supported`);
                return false;
            }
            
            // Insert into editor
            tinyMceEditor.execCommand('mceInsertContent', false, componentHtml);
            return true;
        }
        
