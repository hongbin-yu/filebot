                }
            } else {
                console.error('File manager按钮未找到!');
            }
            // fileManagerHeaderBtn removed as requested - duplicate button

            // Home link (removed as breadcrumb navigation is no longer used)
            // document.getElementById('home-link').addEventListener('click', function(e) {
            //     e.preventDefault();
            //     clearEditor();
            // });

            // Initialize TinyMCE WYSIWYG Editor
            initializeTinyMCE();
            
