<!DOCTYPE html>
<html class="no-js" lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>WebBot Page Editor - Simple</title>


    


    <!-- Canada.ca WET theme CSS -->
    <link rel="stylesheet" href="/gcweb/GCWeb/css/theme.min.css">
    <link rel="stylesheet" href="/gcweb/wet-boew/css/wet-boew.min.css">

    <!-- TinyMCE WYSIWYG Editor CSS -->
    <script src="/gcweb/external/tinymce/tinymce/js/tinymce/tinymce.min.js"></script>

    <!-- Simple custom styles for editor -->
    <style>
        /* Hide Canada.ca default header/footer elements */
        #wb-bnr, #wb-sm, #wb-info, #wb-srch, #wb-lng, .wb-srch, .gcweb-menu, #gcwu-sig {
            display: none !important;
        }

        /* Reposition breadcrumb navigation elements to third line in editor header */
        /* Hide ALL breadcrumb elements except our custom container */
        .wb-breadcrumb:not(.breadcrumb-container):not(#breadcrumb-container *), 
        .breadcrumb:not(.breadcrumb-container):not(#breadcrumb-container *),
        [aria-label*="Breadcrumb"]:not(.breadcrumb-container):not(#breadcrumb-container *),
        [aria-label*="breadcrumb"]:not(.breadcrumb-container):not(#breadcrumb-container *),
        [aria-label*="fil d'ariane"]:not(.breadcrumb-container):not(#breadcrumb-container *),
        nav[role="navigation"]:not(.breadcrumb-container):not(#breadcrumb-container *),
        nav[role="breadcrumb"]:not(.breadcrumb-container):not(#breadcrumb-container *),
        .gc-breadcrumb:not(.breadcrumb-container):not(#breadcrumb-container *),
        .gc-breadcrumbs:not(.breadcrumb-container):not(#breadcrumb-container *),
        .fil-ariane:not(.breadcrumb-container):not(#breadcrumb-container *),
        .fil-dariane:not(.breadcrumb-container):not(#breadcrumb-container *),
        .wet-boew-breadcrumb:not(.breadcrumb-container):not(#breadcrumb-container *),
        .canada-breadcrumb:not(.breadcrumb-container):not(#breadcrumb-container *),
        .wb-navcurr:not(.breadcrumb-container):not(#breadcrumb-container *),
        ol.breadcrumb:not(.breadcrumb-container):not(#breadcrumb-container *),
        ul.wb-breadcrumb:not(.breadcrumb-container):not(#breadcrumb-container *),
        ul.breadcrumb:not(.breadcrumb-container):not(#breadcrumb-container *),
        #breadcrumb:not(.breadcrumb-container):not(#breadcrumb-container *),
        .nav-breadcrumb:not(.breadcrumb-container):not(#breadcrumb-container *),
        .bc:not(.breadcrumb-container):not(#breadcrumb-container *),
        .breadcrumbs:not(.breadcrumb-container):not(#breadcrumb-container *),
        #wb-bc:not(.breadcrumb-container):not(#breadcrumb-container *),
        .wb-bc:not(.breadcrumb-container):not(#breadcrumb-container *),
        #wb-bc-in:not(.breadcrumb-container):not(#breadcrumb-container *),
        .wb-bc-in:not(.breadcrumb-container):not(#breadcrumb-container *) {
            display: none !important;
        }
        /* Note: .breadcrumb-container is our custom container in editor header */
        
        /* Style for breadcrumb container in editor header */
        .breadcrumb-container {
            width: 100%;
            order: 4; /* Appears after page-info (order: 3) */
            margin-top: 5px;
            font-size: 13px;
            color: #666;
            /* Removed background and border for cleaner look */
            padding: 4px 0;
            text-align: center; /* Center alignment as user suggested */
        }
        
        .breadcrumb-container .breadcrumb {
            margin: 0;
            padding: 0;
            background: transparent;
            display: flex;
            flex-wrap: wrap;
            list-style: none;
        }
        
        .breadcrumb-container .breadcrumb-item {
            display: inline-block;
            margin-right: 5px;
        }
        
        .breadcrumb-container .breadcrumb-item + .breadcrumb-item::before {
            content: "›";
            margin: 0 8px;
            color: #999;
        }
        
        .breadcrumb-container .breadcrumb-item a {
            color: #337ab7;
            text-decoration: none;
        }
        
        .breadcrumb-container .breadcrumb-item a:hover {
            color: #23527c;
            text-decoration: underline;
        }

        /* Editor container */
        .editor-container {
            max-width: 1800px;
            margin: 0 auto;
            padding: 20px;
            display: flex;
            gap: 20px;
            height: 90vh;
        }

        /* Left sidebar for page tree */
        .sidebar {
            width: 300px;
            background: white;
            border: 1px solid #ddd;
            border-radius: 4px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            max-height: 90vh;
        }

        .sidebar-header {
            background: #335075;
            color: white;
            padding: 15px;
            font-weight: bold;
            border-bottom: 1px solid #2a4160;
        }

        .page-tree {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
        }

        .tree-category {
            margin-bottom: 10px;
            border: 1px solid #e0e0e0;
            border-radius: 4px;
            overflow: hidden;
        }

        .tree-category-header {
            background-color: #f8f9fa;
            padding: 8px 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #e0e0e0;
            font-weight: 600;
            color: #333;
        }

        .tree-category-header:hover {
            background-color: #e9ecef;
        }

        .tree-category-items {
            padding: 5px 0;
            background-color: white;
        }

        .page-item {
            padding: 8px 12px;
            cursor: pointer;
            border-left: 3px solid transparent;
            transition: all 0.2s;
            margin: 2px 0;
            font-size: 14px;
        }

        .page-item:hover {
            background-color: #f0f7ff;
            border-left-color: #007bff;
        }

        .page-item.active {
            background-color: #e3f2fd;
            border-left-color: #2196F3;
            font-weight: 600;
        }

        /* Main editor area */
        .main-editor {
            flex: 1;
            background: white;
            border: 1px solid #ddd;
            border-radius: 4px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            max-height: 90vh;
            order: 1; /* Display on the left side */
        }

        .editor-header {
            background: #f8f9fa;
            padding: 20px;
            border-bottom: 1px solid #ddd;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: flex-start;
            gap: 15px;
        }

        .editor-header h2 {
            margin: 0;
            color: #333;
            flex: 1;
        }

        .header-actions {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .page-info {
            color: #666;
            font-size: 14px;
            margin-bottom: 5px;
            width: 100%;
            order: 3; /* Ensure it appears after the header and actions */
        }

        .editor-content {
            flex: 1;
            padding: 20px;
            overflow-y: auto;
        }

        /* Form styles */
        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
            color: #333;
        }

        .form-control {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 14px;
            box-sizing: border-box;
        }

        textarea.form-control {
            font-family: monospace;
            min-height: 500px;
            resize: vertical;
        }

        .editor-actions {
            padding: 20px;
            background: #f8f9fa;
            border-top: 1px solid #ddd;
            text-align: right;
        }

        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: background-color 0.2s;
        }

        .btn-primary {
            background-color: #007bff;
            color: white;
        }

        .btn-primary:hover {
            background-color: #0056b3;
        }

        .btn-success {
            background-color: #28a745;
            color: white;
            margin-right: 10px;
        }

        .btn-success:hover {
            background-color: #1e7e34;
        }

        .btn-default {
            background-color: #6c757d;
            color: white;
        }

        .btn-default:hover {
            background-color: #545b62;
        }

        /* Loading and error states */
        .loading {
            text-align: center;
            padding: 40px;
            color: #666;
            font-style: italic;
        }

        .error {
            background: #f8d7da;
            color: #721c24;
            padding: 15px;
            border-radius: 4px;
            border: 1px solid #f5c6cb;
            margin-bottom: 20px;
        }

        .success {
            background: #d4edda;
            color: #155724;
            padding: 15px;
            border-radius: 4px;
            border: 1px solid #c3e6cb;
            margin-bottom: 20px;
        }

        /* Breadcrumb - Generic styles removed to avoid conflicts with custom breadcrumb-container */

        /* .breadcrumb-item generic styles removed to avoid conflicts with custom breadcrumb-container */

        /* WYSIWYG Editor Styles */
        .editor-mode-switcher {
            margin-bottom: 15px;
            display: flex;
            gap: 10px;
        }

        .editor-mode-btn {
            padding: 8px 16px;
            background: #f8f9fa;
            border: 1px solid #ddd;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            color: #333;
        }

        .editor-mode-btn.active {
            background: #007bff;
            color: white;
            border-color: #0056b3;
        }

        .editor-mode-btn:hover:not(.active) {
            background: #e9ecef;
        }

        .wysiwyg-container {
            min-height: 500px;
            border: 1px solid #ddd;
            border-radius: 4px;
            background: white;
        }

        .wysiwyg-container .ql-toolbar {
            border-top-left-radius: 4px;
            border-top-right-radius: 4px;
            border-bottom: 1px solid #ddd;
        }

        .wysiwyg-container .ql-container {
            border-bottom-left-radius: 4px;
            border-bottom-right-radius: 4px;
            min-height: 450px;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            font-size: 16px;
            line-height: 1.6;
        }

        .html-source-container {
            display: none;
        }

        .html-source-container.active {
            display: block;
        }

        .wysiwyg-container {
            display: none;
        }

        .wysiwyg-container.active {
            display: block;
        }

        /* AI Assistant Panel Styles - Scheme 2 (Full Panel) */
        .ai-assistant-panel {
            width: 350px;
            background: white;
            border: 1px solid #ddd;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            display: flex;
            flex-direction: column;
            height: 100%;
            max-height: 90vh;
            order: 2; /* Display on the right side */
            transition: all 0.3s ease;
        }

        .ai-assistant-panel.hidden {
            display: none;
        }



        .ai-panel-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px 16px;
            border-top-left-radius: 8px;
            border-top-right-radius: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .ai-panel-header h3 {
            margin: 0;
            font-size: 16px;
            font-weight: 600;
        }

        .ai-panel-close {
            background: none;
            border: none;
            color: white;
            font-size: 20px;
            cursor: pointer;
            padding: 0;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .ai-panel-body {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .ai-message {
            max-width: 80%;
            padding: 10px 14px;
            border-radius: 18px;
            font-size: 14px;
            line-height: 1.4;
        }

        .ai-message.user {
            background: #e3f2fd;
            align-self: flex-end;
            border-bottom-right-radius: 4px;
        }

        .ai-message.assistant {
            background: #f5f5f5;
            align-self: flex-start;
            border-bottom-left-radius: 4px;
        }

        .ai-message.system {
            background: #fff3e0;
            align-self: center;
            font-style: italic;
            font-size: 12px;
            padding: 6px 10px;
        }

        .ai-panel-input {
            border-top: 1px solid #eee;
            padding: 12px 16px;
            display: flex;
            gap: 8px;
        }

        .ai-input {
            flex: 1;
            padding: 10px 12px;
            border: 1px solid #ddd;
            border-radius: 20px;
            font-size: 14px;
            outline: none;
        }

        .ai-input:focus {
            border-color: #667eea;
        }

        .ai-send-btn {
            background: #667eea;
            color: white;
            border: none;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 18px;
        }

        .ai-send-btn:hover {
            background: #5a6fd8;
        }

        .ai-typing-indicator {
            display: flex;
            gap: 4px;
            padding: 10px 14px;
            background: #f5f5f5;
            border-radius: 18px;
            align-self: flex-start;
            width: fit-content;
        }

        .ai-typing-dot {
            width: 8px;
            height: 8px;
            background: #999;
            border-radius: 50%;
            animation: aiTyping 1.4s infinite ease-in-out;
        }

        .ai-typing-dot:nth-child(1) { animation-delay: -0.32s; }
        .ai-typing-dot:nth-child(2) { animation-delay: -0.16s; }

        @keyframes aiTyping {
            0%, 80%, 100% { transform: scale(0); }
            40% { transform: scale(1); }
        }

        .component-preview {
            background: #f9f9f9;
            border: 1px dashed #ccc;
            border-radius: 8px;
            padding: 12px;
            margin-top: 8px;
            font-size: 12px;
            color: #666;
            max-height: 120px;
            overflow-y: auto;
        }

        .component-preview code {
            font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
            font-size: 11px;
        }

        /* File Manager Panel Styles - Left Sidebar */
        .file-manager-panel {
            width: 350px;
            background: white;
            border: 1px solid #ddd;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            display: flex;
            flex-direction: column;
            height: 100%;
            max-height: 90vh;
            order: 1; /* Display on the left side */
            transition: all 0.3s ease;
        }

        .file-manager-panel.hidden {
            display: none;
        }

        .fm-panel-header {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            color: white;
            padding: 12px 16px;
            border-top-left-radius: 8px;
            border-top-right-radius: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .fm-panel-header h3 {
            margin: 0;
            font-size: 16px;
            font-weight: 600;
        }

        .fm-panel-close {
            background: none;
            border: none;
            color: white;
            font-size: 20px;
            cursor: pointer;
            padding: 0;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .fm-panel-body {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .fm-section {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 6px;
            padding: 12px;
        }

        .fm-section h4 {
            margin-top: 0;
            margin-bottom: 12px;
            font-size: 14px;
            font-weight: 600;
            color: #333;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .fm-upload-area {
            border: 2px dashed #ccc;
            border-radius: 6px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            background-color: #fff;
            transition: all 0.2s;
        }

        .fm-upload-area:hover {
            border-color: #28a745;
            background-color: #f8fff9;
        }

        .fm-upload-icon {
            font-size: 36px;
            margin: 0 0 10px 0;
        }

        .fm-upload-text {
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 8px;
            color: #333;
        }

        .fm-upload-hint {
            font-size: 12px;
            color: #666;
            margin-bottom: 12px;
        }

        .fm-panel-footer {
            padding: 12px 16px;
            border-top: 1px solid #e9ecef;
            background: #f8f9fa;
            border-bottom-left-radius: 8px;
            border-bottom-right-radius: 8px;
            text-align: center;
        }

        /* File card styles for panel */
        .fm-file-card {
            background: white;
            border: 1px solid #ddd;
            border-radius: 6px;
            padding: 12px;
            margin-bottom: 10px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .fm-file-card:hover {
            border-color: #28a745;
            background-color: #f8fff9;
        }

        .fm-file-card.selected {
            border-color: #28a745;
            background-color: #e9ffe9;
            box-shadow: 0 0 0 2px rgba(40, 167, 69, 0.2);
        }

        .fm-file-card-header {
            display: flex;
            align-items: center;
            margin-bottom: 8px;
        }

        .fm-file-name {
            font-size: 14px;
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .fm-file-card-body {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .fm-file-info {
            display: flex;
            gap: 8px;
            font-size: 11px;
            color: #666;
        }

        .fm-file-type,
        .fm-file-size,
        .fm-file-date {
            background: #f1f1f1;
            padding: 2px 6px;
            border-radius: 3px;
        }

        .fm-file-actions {
            display: flex;
            gap: 6px;
            justify-content: flex-end;
        }

        .fm-file-actions .btn-xs {
            padding: 2px 8px;
            font-size: 11px;
        }

        /* Adjust main editor to account for left panel */
        .main-editor {
            flex: 1;
            order: 2; /* Middle position */
        }

        .ai-assistant-panel {
            order: 3; /* Right side */
        }

    </style>
</head>
<body vocab="http://schema.org/" typeof="WebPage" class="">
    <div class="editor-container">

        <!-- File Manager Panel (left sidebar) - Hidden by default as per user request -->
        <div id="file-manager-panel" class="file-manager-panel hidden">
            <div class="fm-panel-header">
                <h3>📁 WebBot File Manager</h3>
                <button class="fm-panel-close" id="fm-panel-close">×</button>
            </div>
            <div class="fm-panel-body" id="fm-panel-body">
                <!-- File upload area -->
                <div class="fm-section">
                    <h4>Upload Files</h4>
                    <div id="fm-upload-area" class="fm-upload-area">
                        <p class="fm-upload-icon">📤</p>
                        <p class="fm-upload-text">Drag & drop files here or click to browse</p>
                        <p class="fm-upload-hint">Maximum file size: 100MB</p>
                        <button type="button" class="btn btn-primary btn-sm" id="fm-browse-files-btn">
                            Browse Files
                        </button>
                        <input type="file" id="fm-file-input" multiple style="display: none;">
                    </div>
                    <div id="fm-upload-progress" style="display: none; margin-top: 15px;">
                        <div class="progress">
                            <div class="progress-bar progress-bar-striped active" role="progressbar" style="width: 0%;">
                                <span class="sr-only">0% Complete</span>
                            </div>
                        </div>
                        <p id="fm-upload-status" style="text-align: center; margin-top: 10px; font-size: 12px;">Uploading...</p>
                    </div>
                </div>
                
                <!-- File list -->
                <div class="fm-section">
                    <h4>Uploaded Files <span id="fm-file-count" class="badge">0</span></h4>
                    <div id="fm-file-list-container">
                        <div class="alert alert-info" id="fm-no-files-message">
                            No files uploaded yet. Upload your first file to get started.
                        </div>
                        <div id="fm-file-list" style="display: none;">
                            <!-- Files will be loaded here -->
                        </div>
                    </div>
                </div>
            </div>
            <div class="fm-panel-footer">
                <button type="button" class="btn btn-primary btn-sm" id="fm-insert-selected-file" disabled>
                    Insert Selected File
                </button>
            </div>
        </div>

        <!-- AI Assistant Panel (right sidebar) -->
        <div id="ai-assistant-panel" class="ai-assistant-panel">
            <div class="ai-panel-header">
                <h3>🤖 WebBot AI Assistant</h3>
                <button class="ai-panel-close" id="ai-panel-close">×</button>
            </div>
            <div class="ai-panel-body" id="ai-chat-messages">
                <div class="ai-message system">
                    Hello! I'm your WebBot AI assistant. I can help you insert components into your Canada.ca page. Try saying "insert button", "social media", "calendar of events", "theme page", or "topic template".
                </div>
            </div>
            <div class="ai-panel-input">
                <input type="text" class="ai-input" id="ai-chat-input" placeholder="Type your message...">
                <button class="ai-send-btn" id="ai-chat-send">➤</button>
            </div>
        </div>

        <!-- Main editor area -->
        <div class="main-editor">
            <div class="editor-header">
                <h2>WebBot Page Editor</h2>
                <div class="header-actions">
                    <button class="btn btn-default btn-sm" title="Help">
                        <span class="glyphicon glyphicon-question-sign" aria-hidden="true"></span>
                    </button>
                </div>
                <!-- Header actions removed as requested - file manager button already exists in main toolbar -->
                <div class="page-info">
                    <span id="page-title-display">No page selected</span>
                    <span id="page-id-display"></span>
                    <span id="page-language-display"></span>
                    <span id="page-status-display"></span>
                </div>
                
                <!-- Breadcrumb container - third line -->
                <div id="breadcrumb-container" class="breadcrumb-container">
                    <nav aria-label="Breadcrumb" class="breadcrumb">
                        <!-- Breadcrumb items will be dynamically inserted here -->
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item"><a href="#">Pages</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Current Page</li>
                    </nav>
                </div>

            </div>

            <div class="editor-content">
                <!-- Loading state -->
                <div id="loading-content" class="loading" style="display: none;">
                    Loading page data...
                </div>

                <!-- Error state -->
