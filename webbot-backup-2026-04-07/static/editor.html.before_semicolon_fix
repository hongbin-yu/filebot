        // Switch between preview and HTML source edit
        function switchToPreviewMode() {
            try {
                const previewContainer = document.getElementById('composing-preview-container');
                const textarea = document.getElementById('page-content');
                const toggleContainer = document.getElementById('mode-toggle-container');
                
                if (!previewContainer || !textarea) {
                    console.error('Preview container or textarea not found');
                    return;
                }
                
                previewContainer.style.display = 'block';
                textarea.style.display = 'none';
                if (toggleContainer) toggleContainer.style.display = 'none';
                
                // Update preview with current content
                console.log('Switching to preview mode, updating preview...');
                const success = updatePreview(textarea.value);
                console.log('Preview update completed, success:', success);
                
                // If preview failed, fall back to HTML edit mode
                if (!success) {
                    console.warn('Preview generation failed, falling back to HTML edit mode');
                    previewContainer.style.display = 'none';
                    textarea.style.display = 'block';
                    if (toggleContainer) toggleContainer.style.display = 'block';
                    showError('Failed to generate preview. Please edit HTML source instead.');
                }
            } catch (error) {
                console.error('Error in switchToPreviewMode:', error);
                // Fallback: show textarea and hide preview
                const textarea = document.getElementById('page-content');
                const previewContainer = document.getElementById('composing-preview-container');
                if (textarea) textarea.style.display = 'block';
                if (previewContainer) previewContainer.style.display = 'none';
                
                showError('Failed to load preview. Please edit HTML source instead.');
            }
        }
        
        function switchToHtmlEditMode() {
            const previewContainer = document.getElementById('composing-preview-container');
            const textarea = document.getElementById('page-content');
            const toggleContainer = document.getElementById('mode-toggle-container');
            
            if (previewContainer && textarea) {
                previewContainer.style.display = 'none';
                textarea.style.display = 'block';
                if (toggleContainer) toggleContainer.style.display = 'block';
            }
        }
