# PCL转PDF转换器 - Windows环境配置文件
# 复制此文件为 .env 并根据需要修改

# Flask应用配置
SECRET_KEY=dev-secret-key-change-in-production
FLASK_ENV=production

# 文件上传配置
MAX_FILE_SIZE=104857600  # 100MB in bytes
ALLOWED_EXTENSIONS=.pcl,.prn,.ps,.eps

# PCL转换工具超时（秒）
PCL_TOOL_TIMEOUT=60

# FileBot API配置
USE_FILEBOT_API=true  # 设置为true启用FileBot API集成
FILEBOT_API_URL=http://localhost:8000/api/v1
FILEBOT_USERNAME=admin
FILEBOT_PASSWORD=admin123

# Windows目录配置
WINDOWS_UPLOAD_DIR=C:\workspace\pcl-uploads
WINDOWS_CONVERTED_DIR=C:\workspace\pcl-converted

# 调试选项
DEBUG=false
LOG_LEVEL=INFO