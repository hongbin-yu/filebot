# FileBot 环境配置

# 应用配置
APP_NAME=FileBot
APP_VERSION=1.0.0
DEBUG=True

# 安全配置
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7天

# 数据库配置 (使用SQLite)
DATABASE_URL=sqlite:///./filebot.db

# 文件存储配置
FILE_STORAGE_PATH=./data/files
TEMP_STORAGE_PATH=./data/temp
MAX_FILE_SIZE=104857600  # 100MB

# CORS配置 (前端开发服务器)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# 转换配置
CONVERSION_TIMEOUT=300  # 5分钟
CONCURRENT_CONVERSIONS=3

# 默认管理员账户
DEFAULT_SUPERUSER_EMAIL=admin@filebot.com
DEFAULT_SUPERUSER_USERNAME=admin
DEFAULT_SUPERUSER_PASSWORD=admin123

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/filebot.log