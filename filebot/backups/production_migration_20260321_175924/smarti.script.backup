CREATE MEMORY TABLE UNIQUEID(TABLENAME VARCHAR_IGNORECASE(63) NOT NULL PRIMARY KEY,ID INTEGER NOT NULL)
CREATE MEMORY TABLE USAGELOG(ID INTEGER NOT NULL PRIMARY KEY,T_STAMP TIMESTAMP NOT NULL,USER_ID SMALLINT NOT NULL,EVENT SMALLINT NOT NULL,INFO VARCHAR_IGNORECASE(255),SESSION_NO INTEGER,USERNAME VARCHAR_IGNORECASE(127))
CREATE MEMORY TABLE USERS(ID INTEGER NOT NULL PRIMARY KEY,USER_NAME VARCHAR_IGNORECASE(30),PASSWORD VARCHAR_IGNORECASE(60),EMAIL VARCHAR_IGNORECASE(100),PHONENUMBER VARCHAR_IGNORECASE(30))
CREATE MEMORY TABLE USER_INFORMATION(USER_NAME VARCHAR_IGNORECASE(31) NOT NULL PRIMARY KEY,COMMENTS VARCHAR_IGNORECASE(255),SECURITY VARCHAR_IGNORECASE(255),CLEARANCE SMALLINT)
CREATE MEMORY TABLE PAGES(PARENT_ID INTEGER NOT NULL,PAGE_NUM INTEGER NOT NULL,PAGE_TYPE_ID INTEGER,EXTERN_ID INTEGER NOT NULL,EXTERN_OFFSET INTEGER,DELETED SMALLINT,HAS_NOTES SMALLINT,INDEX1 VARCHAR_IGNORECASE(127),INDEX2 VARCHAR_IGNORECASE(127),INDEX3 VARCHAR_IGNORECASE(127),INDEX4 VARCHAR_IGNORECASE(127),INDEX5 VARCHAR_IGNORECASE(127),INDEX6 VARCHAR_IGNORECASE(127),INDEXED SMALLINT,PAGE_COUNT INTEGER,PRIMARY KEY(PARENT_ID,PAGE_NUM),CONSTRAINT FK485F7A4EC57399E FOREIGN KEY(EXTERN_ID) REFERENCES EXTERNAL_FILE(ID),CONSTRAINT FK485F7A489240316 FOREIGN KEY(PAGE_TYPE_ID) REFERENCES PAGE_TYPE(ID),CONSTRAINT FK485F7A431EC05CB FOREIGN KEY(PARENT_ID) REFERENCES DOC(ID))
CREATE MEMORY TABLE PAGE_NOTES(DOCID INTEGER NOT NULL,PAGENUM INTEGER NOT NULL,NOTENUM SMALLINT NOT NULL,XCORD SMALLINT,YCORD SMALLINT,PRIMARY KEY(DOCID,PAGENUM,NOTENUM))
CREATE MEMORY TABLE SAVEDGRAPHS(ID INTEGER NOT NULL PRIMARY KEY,NEXT_GRAPH_ID INTEGER,ROWS_PER_GRAPH SMALLINT,READ_ONLY CHAR(1),GRAPH_SIZE SMALLINT,CONSTRAINT FKA66C2A0C1056F119 FOREIGN KEY(ID) REFERENCES SAVEDNAMES(ID),CONSTRAINT FKA66C2A0C1D9AB176 FOREIGN KEY(NEXT_GRAPH_ID) REFERENCES SAVEDNAMES(ID))
CREATE MEMORY TABLE SIMPLEINDEX(ID INTEGER NOT NULL PRIMARY KEY,APPLICATION VARCHAR_IGNORECASE(127),DRAWER VARCHAR_IGNORECASE(127),FOLDER VARCHAR_IGNORECASE(127),DOCUMENT VARCHAR_IGNORECASE(127),INDEX1 VARCHAR_IGNORECASE(127),INDEX2 VARCHAR_IGNORECASE(127),INDEX3 VARCHAR_IGNORECASE(127),INDEX4 VARCHAR_IGNORECASE(127),INDEX5 VARCHAR_IGNORECASE(127),INDEX6 VARCHAR_IGNORECASE(127),TEXT VARCHAR_IGNORECASE(2550),IMAGEPATH VARCHAR_IGNORECASE(255),DATEFORMATS VARCHAR_IGNORECASE(127),RECORDCLASS VARCHAR_IGNORECASE(127),RESULT VARCHAR_IGNORECASE(255),OUTPUT VARCHAR_IGNORECASE(127),ADMIN VARCHAR_IGNORECASE(30),REPORT VARCHAR_IGNORECASE(60))
CREATE MEMORY TABLE NOTES(HI_ID INTEGER NOT NULL,PAGE_NUM INTEGER NOT NULL,AUTHOR_ID SMALLINT NOT NULL,SCRIPT VARCHAR_IGNORECASE(255),ISSUE_DATE DATE,ISSUE_TIME DATE,PRIMARY KEY(HI_ID,PAGE_NUM),CONSTRAINT FK47056A16450F1B6 FOREIGN KEY(HI_ID,PAGE_NUM) REFERENCES PAGES(PARENT_ID,PAGE_NUM))
CREATE MEMORY TABLE SMARTGROUPS(GROUP_NAME VARCHAR(30) NOT NULL PRIMARY KEY,GROUP_ID INTEGER)
CREATE MEMORY TABLE SMARTMEMBERS(GROUP_NAME VARCHAR(30) NOT NULL,MEMBER_NAME VARCHAR(30) NOT NULL,PRIMARY KEY(GROUP_NAME,MEMBER_NAME))
CREATE MEMORY TABLE SMARTUSERS(USER_NAME VARCHAR(30) NOT NULL PRIMARY KEY,USER_ID INTEGER)
