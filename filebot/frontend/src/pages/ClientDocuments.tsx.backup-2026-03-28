import React, { useState, useEffect } from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import drawerService from '../services/drawer.service';
import { Drawer } from '../services/drawer.service';
import documentService from '../services/document.service';
import './ClientDocuments.css';

interface PageIndices {
  index1?: string;
  index2?: string;
  index3?: string;
  index4?: string;
  index5?: string;
  index6?: string;
  index7?: string;
  index8?: string;
  index9?: string;
}

interface DocumentPage {
  page_number: number;
  indices: PageIndices;
}

interface ClientDocument {
  id: string;
  title: string;
  original_filename: string;
  file_type: string;
  conversion_status?: string;
  created_at: string;
  pages: DocumentPage[];
}

const ClientDocuments: React.FC = () => {
  const { appId, drawerSlug } = useParams<{ appId: string, drawerSlug: string }>();
  const navigate = useNavigate();
  
  const [drawer, setDrawer] = useState<Drawer | null>(null);
  const [appIndices, setAppIndices] = useState<string[] | null>(null); // App的索引配置
  const [allowedFileTypes, setAllowedFileTypes] = useState<string[] | null>(null); // App允许显示的文件类型，null表示无限制（显示所有）
  const [documents, setDocuments] = useState<ClientDocument[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [searchTerm, setSearchTerm] = useState('');
  const [filteredDocuments, setFilteredDocuments] = useState<ClientDocument[]>([]);

  useEffect(() => {
    if (appId && drawerSlug) {
      fetchDrawerAndDocuments();
    }
  }, [appId, drawerSlug]);

  useEffect(() => {
    filterDocuments();
  }, [documents, searchTerm]);

  const fetchDrawerAndDocuments = async () => {
    try {
      setLoading(true);
      setError(null);
      
      let appFileTypes: string[] | null = null; // null表示无限制，显示所有文件
      
      // 首先获取App详情和索引配置
      if (appId) {
        const appData = await drawerService.getAppWithSettings(appId);
        if (appData?.settings?.indices) {
          setAppIndices(appData.settings.indices);
        } else {
          setAppIndices([]); // 空数组表示没有索引配置
        }
        // 获取App允许显示的文件类型配置
        if (appData?.settings?.client_file_types && appData.settings.client_file_types.length > 0) {
          appFileTypes = appData.settings.client_file_types;
          setAllowedFileTypes(appData.settings.client_file_types);
        } else {
          setAllowedFileTypes(null); // null表示无限制，显示所有文件类型
        }
      }
      
      // 获取drawer信息
      const drawerData = await drawerService.getDrawerBySlug(drawerSlug!);
      if (!drawerData) {
        throw new Error(`未找到drawer: ${drawerSlug}`);
      }
      setDrawer(drawerData);
      
      // 获取drawer下的文档（包含页面索引信息）
      const documentsWithIndices = await drawerService.getDrawerPageIndices(drawerData.id);
      
      // 转换为ClientDocument格式
      const clientDocs: ClientDocument[] = documentsWithIndices.map((doc: any) => ({
        id: doc.id,
        title: doc.title || doc.original_filename,
        original_filename: doc.original_filename,
        file_type: doc.file_type,
        conversion_status: doc.conversion_status,
        created_at: doc.created_at,
        pages: doc.pages || []
      }));
      
      // 根据App设置过滤文档
      const filteredDocs = clientDocs.filter(doc => {
        const docFileType = doc.file_type.toLowerCase();
        
        // 如果没有限制（null或空数组），显示所有文件
        if (!appFileTypes || appFileTypes.length === 0) {
          return true;
        }
        
        const allowedTypes = appFileTypes.map(t => t.toLowerCase());
        
        // 1. 如果文件类型在允许的列表中，则显示
        if (allowedTypes.includes(docFileType)) {
          return true;
        }
        // 2. 如果文件类型不是PDF但已转换完成，也应该显示（用户看到的是PDF版本）
        if (doc.conversion_status === 'completed' && docFileType !== 'pdf') {
          return true;
        }
        // 3. 否则不显示
        return false;
      });
      
      setDocuments(filteredDocs);
      
    } catch (err: any) {
      console.error('获取drawer或文档失败:', err);
      setError(err.message || '无法加载文档列表');
    } finally {
      setLoading(false);
    }
  };

  const filterDocuments = () => {
    if (!searchTerm.trim()) {
      setFilteredDocuments(documents);
      return;
    }
    
    const term = searchTerm.toLowerCase();
    const filtered = documents.filter(doc => {
      // 搜索文档标题
      if (doc.title.toLowerCase().includes(term)) {
        return true;
      }
      
      // 搜索原始文件名
      if (doc.original_filename.toLowerCase().includes(term)) {
        return true;
      }
      
      // 搜索页面索引
      for (const page of doc.pages) {
        const indices = Object.values(page.indices);
        if (indices.some(index => index && index.toLowerCase().includes(term))) {
          return true;
        }
      }
      
      return false;
    });
    
    setFilteredDocuments(filtered);
  };

  const handleBackToDashboard = () => {
    navigate(`/client/apps/${appId}`);
  };

  const handleViewDocument = (documentId: string) => {
    // 在新标签页中打开PDF查看器
    const pdfUrl = `http://localhost:8001/api/v1/documents/${documentId}/view`;
    window.open(pdfUrl, '_blank');
  };

  const handleDownloadDocument = (documentId: string, filename: string) => {
    // 下载PDF文件
    const downloadUrl = `http://localhost:8001/api/v1/documents/${documentId}/download`;
    const link = document.createElement('a');
    link.href = downloadUrl;
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  const formatDate = (dateString: string) => {
    const date = new Date(dateString);
    return date.toLocaleDateString('zh-CN', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    });
  };

  const getPageRange = (pages: DocumentPage[]) => {
    if (pages.length === 0) return 'N/A';
    const pageNumbers = pages.map(p => p.page_number).sort((a, b) => a - b);
    const min = pageNumbers[0];
    const max = pageNumbers[pageNumbers.length - 1];
    return min === max ? `${min}` : `${min}-${max}`;
  };

  const getIndicesForDisplay = (pages: DocumentPage[]) => {
    if (pages.length === 0 || !appIndices || appIndices.length === 0) {
      return [];
    }
    
    // 对于多页文档，显示第一页的索引
    const firstPage = pages[0];
    // 根据App的索引配置，提取对应的索引值
    return appIndices.map((_, idx) => {
      const indexNum = idx + 1; // index1, index2, ...
      const key = `index${indexNum}` as keyof PageIndices;
      return firstPage.indices[key] || '';
    });
  };

  if (loading) {
    return (
      <div className="client-documents min-h-screen bg-gray-50 p-8">
        <div className="max-w-7xl mx-auto">
          <div className="flex justify-between items-center mb-8">
            <div className="h-8 w-64 bg-gray-200 animate-pulse rounded"></div>
            <div className="h-10 w-32 bg-gray-200 animate-pulse rounded"></div>
          </div>
          
          <div className="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
            <div className="h-6 w-48 bg-gray-200 animate-pulse rounded mb-4"></div>
            <div className="h-4 w-96 bg-gray-100 animate-pulse rounded"></div>
          </div>
          
          <div className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div className="h-12 bg-gray-100 border-b border-gray-200"></div>
            {[1, 2, 3, 4, 5].map(i => (
              <div key={i} className="h-16 border-b border-gray-100 animate-pulse">
                <div className="h-full flex items-center px-6">
                  <div className="flex-1">
                    <div className="h-4 w-48 bg-gray-200 rounded mb-2"></div>
                    <div className="h-3 w-32 bg-gray-100 rounded"></div>
                  </div>
                  <div className="flex space-x-4">
                    {/* 动态索引列占位符 */}
                    {(appIndices && appIndices.length > 0 ? appIndices : Array(3).fill('')).map((_, idx) => (
                      <div key={idx} className="h-4 w-16 bg-gray-100 rounded"></div>
                    ))}
                  </div>
                  <div className="ml-8 h-8 w-24 bg-gray-200 rounded"></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="client-documents min-h-screen bg-gray-50 p-8">
        <div className="max-w-7xl mx-auto">
          <div className="flex justify-between items-center mb-8">
            <h1 className="text-3xl font-bold text-gray-800">错误</h1>
            <button
              onClick={handleBackToDashboard}
              className="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-lg font-medium transition-colors"
            >
              返回Dashboard
            </button>
          </div>
          
          <div className="bg-red-50 border border-red-200 rounded-xl p-6">
            <h2 className="text-xl font-semibold text-red-800 mb-2">加载失败</h2>
            <p className="text-red-700 mb-4">{error}</p>
            <button
              onClick={fetchDrawerAndDocuments}
              className="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg font-medium transition-colors"
            >
              重试
            </button>
          </div>
        </div>
      </div>
    );
  }

  // 计算表格总列数
  const totalColumns = 2 + (appIndices?.length || 0); // 文档信息列 + 索引列数 + 页码列 + 操作列

  return (
    <div className="client-documents min-h-screen bg-gray-50 p-8">
      <div className="max-w-7xl mx-auto">
        {/* 头部 */}
        <div className="flex justify-between items-center mb-8">
          <div>
            <h1 className="text-3xl font-bold text-gray-800">
              {drawer?.name || '未知Drawer'}
            </h1>
            <p className="text-gray-600 mt-2">
              {drawer?.description || '文档浏览'}
              {drawer?.app && ` • 应用: ${drawer.app.name}`}
            </p>
          </div>
          <div className="flex space-x-4">
            <button
              onClick={handleBackToDashboard}
              className="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-lg font-medium transition-colors"
            >
              返回Dashboard
            </button>
            <button
              onClick={() => navigate('/client/apps')}
              className="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors"
            >
              切换Drawer
            </button>
          </div>
        </div>

        {/* 搜索框 */}
        <div className="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
          <div className="flex justify-between items-center mb-4">
            <h2 className="text-xl font-semibold text-gray-800">文档搜索</h2>
            <div className="text-gray-500">
              共 {documents.length} 个文档（根据App设置过滤）
            </div>
          </div>
          <div className="flex space-x-4">
            <input
              type="text"
              placeholder="搜索文档名称、文件名或索引字段..."
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              className="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
            <button
              onClick={() => setSearchTerm('')}
              className="px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-800 rounded-lg font-medium transition-colors"
            >
              清除
            </button>
          </div>
          <div className="mt-4 text-sm text-gray-500">
            提示：您可以按文档名称、文件名{
              appIndices && appIndices.length > 0 
                ? `或任何索引字段（${appIndices.join('、')}）`
                : ''
            }进行搜索。
          </div>
          <div className="mt-2 text-sm text-blue-600 bg-blue-50 px-3 py-2 rounded-md">
            📄 当前App允许的文件类型：{
              allowedFileTypes && allowedFileTypes.length > 0 
                ? `${allowedFileTypes.map(type => type.toUpperCase()).join(', ')}${allowedFileTypes.includes('pdf') ? ' (默认)' : ''}`
                : '所有类型 (无限制)'
            }
          </div>
        </div>

        {/* 文档表格 */}
        <div className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
          <div className="overflow-x-auto">
            <table className="min-w-full divide-y divide-gray-200">
              <thead className="bg-gray-50">
                <tr>
                  <th scope="col" className="px-6 py-4 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">
                    文档信息
                  </th>
                  {/* 动态索引列 - 基于App的索引配置 */}
                  {appIndices && appIndices.length > 0 ? (
                    appIndices.map((indexName, idx) => (
                      <th
                        key={idx}
                        scope="col"
                        className="px-3 py-4 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider whitespace-nowrap"
                      >
                        {indexName}
                      </th>
                    ))
                  ) : null}
                  <th scope="col" className="px-6 py-4 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">
                    页码
                  </th>
                  <th scope="col" className="px-6 py-4 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">
                    操作
                  </th>
                </tr>
              </thead>
              <tbody className="bg-white divide-y divide-gray-100">
                {filteredDocuments.length === 0 ? (
                  <tr>
                    <td colSpan={totalColumns} className="px-6 py-12 text-center text-gray-500">
                      {documents.length === 0 
                        ? (allowedFileTypes && allowedFileTypes.length > 0 
                            ? `该drawer中没有允许的文件类型（${allowedFileTypes.map(t => t.toUpperCase()).join(', ')}）` 
                            : '该drawer中没有文档')
                        : '没有找到匹配的文档'
                      }
                    </td>
                  </tr>
                ) : (
                  filteredDocuments.map((doc) => {
                    const indices = getIndicesForDisplay(doc.pages);
                    const pageRange = getPageRange(doc.pages);
                    
                    return (
                      <tr key={doc.id} className="hover:bg-gray-50 transition-colors">
                        {/* 文档信息列 */}
                        <td className="px-6 py-4">
                          <div>
                            <div className="font-medium text-gray-900">{doc.title}</div>
                            <div className="text-sm text-gray-500 mt-1">{doc.original_filename}</div>
                            <div className="text-xs text-gray-400 mt-1">
                              {formatDate(doc.created_at)}
                              {doc.file_type !== 'pdf' && (
                                <span className="ml-2 bg-yellow-100 text-yellow-800 px-2 py-1 rounded">
                                  已转换
                                </span>
                              )}
                            </div>
                          </div>
                        </td>
                        
                        {/* 动态索引列 */}
                        {indices.map((value, idx) => (
                          <td key={idx} className="px-3 py-4 text-sm text-gray-700 max-w-[120px] truncate">
                            {value || '-'}
                          </td>
                        ))}
                        
                        {/* 页码列 */}
                        <td className="px-6 py-4 text-sm text-gray-700">
                          <div className="font-medium">{pageRange}</div>
                          <div className="text-xs text-gray-500">
                            {doc.pages.length} 页
                          </div>
                        </td>
                        
                        {/* 操作列 */}
                        <td className="px-6 py-4">
                          <div className="flex space-x-2">
                            <button
                              onClick={() => handleViewDocument(doc.id)}
                              className="px-3 py-1.5 bg-blue-100 hover:bg-blue-200 text-blue-700 rounded text-sm font-medium transition-colors"
                            >
                              查看
                            </button>
                            <button
                              onClick={() => handleDownloadDocument(doc.id, doc.original_filename)}
                              className="px-3 py-1.5 bg-green-100 hover:bg-green-200 text-green-700 rounded text-sm font-medium transition-colors"
                            >
                              下载
                            </button>
                          </div>
                        </td>
                      </tr>
                    );
                  })
                )}
              </tbody>
            </table>
          </div>
        </div>

        {/* 使用说明 */}
        <div className="mt-8 bg-blue-50 border border-blue-200 rounded-xl p-6">
          <h3 className="text-lg font-semibold text-blue-800 mb-2">如何使用此界面</h3>
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm text-blue-700">
            <div>
              <h4 className="font-medium mb-1">📋 文档列表</h4>
              <p>表格显示{
                allowedFileTypes && allowedFileTypes.length > 0 
                  ? `App允许的文件类型（${allowedFileTypes.map(t => t.toUpperCase()).join(', ')}）`
                  : '所有类型'
              }文档及其索引字段。</p>
            </div>
            <div>
              <h4 className="font-medium mb-1">🔍 搜索功能</h4>
              <p>可以在任何索引字段{
                appIndices && appIndices.length > 0 
                  ? `（${appIndices.join('、')}）`
                  : ''
              }中搜索关键词。</p>
            </div>
            <div>
              <h4 className="font-medium mb-1">📄 查看文档</h4>
              <p>点击"查看"在新标签页中打开PDF，"下载"按钮可直接下载文件。</p>
            </div>
          </div>
          <div className="mt-4 pt-4 border-t border-blue-200 text-xs text-blue-600">
            <strong>注意：</strong>{
              allowedFileTypes && allowedFileTypes.length > 0 && allowedFileTypes.every(t => t.toLowerCase() === 'pdf')
                ? '此界面仅显示PDF格式文档。如果其他格式文档需要查看，请联系管理员进行转换。'
                : '此界面根据App设置显示文档。非PDF格式文档在转换完成后会显示为PDF版本。'
            }
          </div>
        </div>
      </div>
    </div>
  );
};

export default ClientDocuments;