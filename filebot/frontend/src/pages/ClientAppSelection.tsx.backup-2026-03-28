import React, { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import drawerService from '../services/drawer.service';
import { ClientApp } from '../services/drawer.service';
import './ClientAppSelection.css';

const ClientAppSelection: React.FC = () => {
  const navigate = useNavigate();
  const [apps, setApps] = useState<ClientApp[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    fetchApps();
  }, []);

  const fetchApps = async () => {
    try {
      setLoading(true);
      setError(null);
      
      // 获取Client可访问的App列表
      const data = await drawerService.getClientApps();
      setApps(data);
    } catch (err: any) {
      console.error('获取App列表失败:', err);
      setError(err.response?.data?.detail || err.message || '无法加载App列表');
    } finally {
      setLoading(false);
    }
  };

  const handleAppClick = (app: ClientApp) => {
    // 导航到该App的dashboard（显示该App下的drawers）
    const appSlug = app.slug || app.id;
    navigate(`/client/apps/${appSlug}`);
  };

  const handleLogout = () => {
    // 清除Client认证信息
    localStorage.removeItem('client_access_token');
    localStorage.removeItem('client_user_info');
    navigate('/client/login');
  };

  const handleBackToLogin = () => {
    navigate('/client/login');
  };

  // 获取App图标的首字母
  const getAppInitial = (name: string) => {
    return name.charAt(0).toUpperCase();
  };

  // 格式化日期
  const formatDate = (dateString?: string) => {
    if (!dateString) return '未知';
    return new Date(dateString).toLocaleDateString('zh-CN');
  };

  if (loading) {
    return (
      <div className="client-app-selection">
        <button onClick={handleBackToLogin} className="back-button">
          ← 返回登录
        </button>
        <div className="loading-container">
          <div className="loading-spinner"></div>
          <p>正在加载应用列表...</p>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="client-app-selection">
        <button onClick={handleBackToLogin} className="back-button">
          ← 返回登录
        </button>
        <h1>应用选择</h1>
        <p className="subtitle">选择要访问的应用</p>
        <div className="error-state">
          <p><strong>错误:</strong> {error}</p>
          <button 
            onClick={fetchApps}
            style={{ marginTop: '1rem', padding: '0.5rem 1rem', background: '#ef4444', color: 'white', border: 'none', borderRadius: '4px', cursor: 'pointer' }}
          >
            重试
          </button>
        </div>
      </div>
    );
  }

  if (apps.length === 0) {
    return (
      <div className="client-app-selection">
        <button onClick={handleBackToLogin} className="back-button">
          ← 返回登录
        </button>
        <h1>应用选择</h1>
        <p className="subtitle">选择要访问的应用</p>
        <div className="empty-state">
          <p>没有可访问的应用。</p>
          <p>请联系管理员为您分配访问权限。</p>
        </div>
      </div>
    );
  }

  return (
    <div className="client-app-selection">
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '1rem' }}>
        <button onClick={handleBackToLogin} className="back-button">
          ← 返回登录
        </button>
        <button 
          onClick={handleLogout}
          style={{ 
            padding: '0.5rem 1rem', 
            background: '#ef4444', 
            color: 'white', 
            border: 'none', 
            borderRadius: '4px', 
            cursor: 'pointer',
            fontSize: '0.875rem'
          }}
        >
          退出登录
        </button>
      </div>
      
      <h1>应用选择</h1>
      <p className="subtitle">选择要访问的应用</p>
      
      <div className="app-grid">
        {apps.map((app) => (
          <div 
            key={app.id} 
            className="app-card"
            onClick={() => handleAppClick(app)}
            role="button"
            tabIndex={0}
            onKeyDown={(e) => {
              if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                handleAppClick(app);
              }
            }}
          >
            <div className="app-card-header">
              <div className="app-icon">
                {getAppInitial(app.name)}
              </div>
              <div className="app-info">
                <h3 className="app-name">{app.name}</h3>
                <p className="app-description">{app.description || '暂无描述'}</p>
              </div>
            </div>
            
            <div className="app-stats">
              <div className="stat-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="3" y1="9" x2="21" y2="9"></line>
                  <line x1="9" y1="21" x2="9" y2="9"></line>
                </svg>
                <span>{app.drawer_count || 0} 个抽屉</span>
              </div>
              <div className="stat-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
                <span>{app.document_count || 0} 个文档</span>
              </div>
            </div>
            
            <div style={{ fontSize: '0.75rem', color: '#9ca3af', marginTop: '0.5rem' }}>
              更新于: {formatDate(app.updated_at)}
            </div>
            
            {/* 显示App的索引配置信息 */}
            {app.settings?.indices && app.settings.indices.length > 0 && (
              <div style={{ 
                marginTop: '0.75rem', 
                padding: '0.5rem', 
                background: '#f3f4f6', 
                borderRadius: '4px',
                fontSize: '0.75rem'
              }}>
                <strong>索引配置:</strong> {app.settings.indices.join(', ')}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  );
};

export default ClientAppSelection;