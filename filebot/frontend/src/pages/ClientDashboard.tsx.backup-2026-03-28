import React, { useState, useEffect } from 'react';
import { useNavigate, useParams } from 'react-router-dom';
import drawerService from '../services/drawer.service';
import { Drawer, ClientApp } from '../services/drawer.service';
import './ClientDashboard.css';

const ClientDashboard: React.FC = () => {
  const navigate = useNavigate();
  const { appId } = useParams<{ appId: string }>();
  const [drawers, setDrawers] = useState<Drawer[]>([]);
  const [app, setApp] = useState<ClientApp | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    if (appId) {
      fetchAppAndDrawers();
    } else {
      setError('缺少App ID参数');
      setLoading(false);
    }
  }, [appId]);

  const fetchAppAndDrawers = async () => {
    try {
      setLoading(true);
      setError(null);
      
      // 获取App详情
      const appData = await drawerService.getAppWithSettings(appId!);
      if (!appData) {
        throw new Error(`未找到App: ${appId}`);
      }
      setApp(appData);
      
      // 获取该App下的drawers
      const drawersData = await drawerService.getDrawersByApp(appId!);
      setDrawers(drawersData);
    } catch (err: any) {
      console.error('获取App或drawer列表失败:', err);
      setError(err.response?.data?.detail || err.message || '无法加载App或drawer列表');
    } finally {
      setLoading(false);
    }
  };

  const handleDrawerClick = (drawer: Drawer) => {
    // 导航到Client文档浏览页面 (APP-first导航)
    const drawerSlug = drawer.slug || drawer.id;
    navigate(`/client/apps/${appId}/drawers/${drawerSlug}/documents`);
  };

  const handleLogout = () => {
    // 清除Client认证信息
    localStorage.removeItem('client_access_token');
    localStorage.removeItem('client_user_info');
    navigate('/client/login');
  };

  if (loading) {
    return (
      <div className="client-dashboard min-h-screen bg-gradient-to-b from-blue-50 to-white p-8">
        <div className="max-w-6xl mx-auto">
          <div className="flex justify-between items-center mb-8">
            <h1 className="text-3xl font-bold text-gray-800">FileBot Client Portal</h1>
            <div className="w-24 h-8 bg-gray-200 animate-pulse rounded"></div>
          </div>
          <p className="text-gray-600 mb-8">加载drawer列表中...</p>
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {[1, 2, 3, 4, 5, 6].map(i => (
              <div key={i} className="bg-white rounded-xl shadow-sm border border-gray-200 p-6 animate-pulse">
                <div className="h-6 bg-gray-200 rounded mb-4"></div>
                <div className="h-4 bg-gray-100 rounded mb-2"></div>
                <div className="h-4 bg-gray-100 rounded mb-4"></div>
                <div className="h-8 bg-gray-200 rounded"></div>
              </div>
            ))}
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="client-dashboard min-h-screen bg-gradient-to-b from-blue-50 to-white p-8">
      <div className="max-w-6xl mx-auto">
        {/* 头部 */}
        <div className="flex justify-between items-center mb-8">
          <div className="flex items-center">
            <button
              onClick={() => navigate('/client/apps')}
              className="mr-4 px-3 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded text-sm font-medium transition-colors"
            >
              ← 返回App列表
            </button>
            <div>
              <h1 className="text-3xl font-bold text-gray-800">FileBot Client Portal</h1>
              <p className="text-gray-600 mt-2">浏览和查看PDF文档</p>
            </div>
          </div>
          <button
            onClick={handleLogout}
            className="px-4 py-2 bg-red-100 text-red-700 hover:bg-red-200 rounded-lg font-medium transition-colors"
          >
            退出登录
          </button>
        </div>

        {/* 错误信息 */}
        {error && (
          <div className="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
            <div className="flex justify-between items-start">
              <div>
                <p className="font-medium">{error}</p>
              </div>
              <button
                onClick={() => navigate('/client/apps')}
                className="ml-4 px-3 py-1 bg-red-100 hover:bg-red-200 text-red-700 rounded text-sm font-medium transition-colors whitespace-nowrap"
              >
                返回App列表
              </button>
            </div>
          </div>
        )}

        {/* 说明 */}
        <div className="bg-blue-50 border border-blue-200 rounded-xl p-6 mb-8">
          <h2 className="text-xl font-semibold text-blue-800 mb-2">欢迎使用Client门户</h2>
          <p className="text-blue-700 mb-3">
            这是一个只读界面，用于浏览和查看PDF文档。您可以：
          </p>
          <ul className="list-disc list-inside text-blue-700 space-y-1 ml-4">
            <li>浏览您有权限访问的drawer</li>
            <li>查看PDF文档列表</li>
            <li>通过application indices快速查找文档</li>
            <li>查看文档的page indexes</li>
            <li>查看或下载PDF文件</li>
          </ul>
          <div className="mt-4 text-sm text-blue-600">
            <strong>注意：</strong>仅支持PDF格式文档。其他格式的文档不会在此界面显示。
          </div>
        </div>

        {/* Drawer列表 */}
        <div className="mb-6">
          <h2 className="text-2xl font-bold text-gray-800 mb-4">可访问的Drawer</h2>
          {drawers.length === 0 ? (
            <div className="bg-yellow-50 border border-yellow-200 rounded-xl p-8 text-center">
              <p className="text-yellow-700 text-lg">暂无可访问的drawer</p>
              <p className="text-yellow-600 mt-2">请联系管理员获取访问权限</p>
            </div>
          ) : (
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {drawers.map((drawer) => (
                <div
                  key={drawer.id}
                  className="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md hover:border-blue-300 transition-all duration-200 cursor-pointer p-6"
                  onClick={() => handleDrawerClick(drawer)}
                >
                  <div className="flex items-start justify-between mb-4">
                    <div>
                      <h3 className="text-xl font-semibold text-gray-800 mb-1">{drawer.name}</h3>
                      <p className="text-sm text-gray-500">Drawer ID: {drawer.id.substring(0, 8)}...</p>
                    </div>
                    <div className="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">
                      PDF浏览
                    </div>
                  </div>
                  
                  {drawer.description && (
                    <p className="text-gray-600 mb-4 line-clamp-2">{drawer.description}</p>
                  )}
                  
                  <div className="text-sm text-gray-500 mb-4">
                    <div className="flex items-center mb-1">
                      <span className="w-20">应用:</span>
                      <span className="font-medium">{drawer.app?.name || 'Unknown App'}</span>
                    </div>
                    <div className="flex items-center">
                      <span className="w-20">Slug:</span>
                      <span className="font-mono bg-gray-100 px-2 py-1 rounded">
                        {drawer.slug || '无'}
                      </span>
                    </div>
                  </div>
                  
                  <button
                    className="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors"
                    onClick={(e) => {
                      e.stopPropagation();
                      handleDrawerClick(drawer);
                    }}
                  >
                    浏览文档
                  </button>
                </div>
              ))}
            </div>
          )}
        </div>

        {/* 页脚说明 */}
        <div className="mt-12 pt-6 border-t border-gray-200">
          <div className="flex flex-col md:flex-row justify-between items-center text-sm text-gray-500">
            <div>
              <p className="mb-1">© 2026 FileBot Client Portal. 仅供内部使用。</p>
              <p>这是一个只读界面，所有文档均为PDF格式。</p>
            </div>
            <div className="mt-4 md:mt-0">
              <p className="text-gray-400">版本: 1.0.0 | Client模式</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

export default ClientDashboard;