const DEV_MODE = true;

export interface Folder {
  id: string;
  name: string;
  description?: string;
  parent_folder_id?: string;
  app_id: string;
  created_by: string;
  created_at: string;
  updated_at?: string;
  document_count?: number;
  total_size?: number;
  children?: Folder[];
}

export interface FolderCreateRequest {
  name: string;
  description?: string;
  parent_folder_id?: string;
  app_id: string;
  drawer_id?: string;  // 可选抽屉ID，如果未提供则使用应用下第一个抽屉
}

export interface FolderUpdateRequest {
  name?: string;
  description?: string;
  parent_folder_id?: string;
}

export interface MoveFolderRequest {
  target_drawer_id?: string;  // 跨drawer移动（根据用户要求，Folder只能在同drawer内移动，这个字段可能不需要）
  target_parent_folder_id?: string;  // 同drawer内改变父文件夹
}

export interface FolderTreeItem extends Folder {
  children?: FolderTreeItem[];
  level: number;
  expanded?: boolean;
}

