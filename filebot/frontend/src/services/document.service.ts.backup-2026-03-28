  // 获取TIFF缩略图URL
  getTiffThumbnailUrl(documentId: string, pageNumber: number, width: number = 200, height: number = 200): string {
    return `/documents/${documentId}/tiff-thumbnail/${pageNumber}?width=${width}&height=${height}`;
  }

  // 获取TIFF预览图URL
