  // 搜索文档
  async searchDocuments(params: DocumentSearchParams): Promise<Document[]> {
    // 开发模式：使用模拟数据
    if (DEV_MODE) {
      console.log('🔧 开发模式：searchDocuments', params);
      
      // 使用getDocuments中的模拟数据（已包含内存中的文档）
      const mockDocuments = await this.getDocuments(params);
      
      // 简单的关键词过滤（模拟搜索）
      if (params.title) {
        const searchTerm = params.title.toLowerCase();
        return mockDocuments.filter(doc => 
          doc.title?.toLowerCase().includes(searchTerm) ||
          doc.description?.toLowerCase().includes(searchTerm)
        );
      }
      
      return mockDocuments;
    }
    
    // 生产模式：调用真实API
    const response = await api.get('/search/documents', { params });
    return response.data;
  }

