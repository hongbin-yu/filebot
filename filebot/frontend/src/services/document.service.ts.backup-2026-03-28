  // 上传文档
  async uploadDocument(data: DocumentUploadRequest): Promise<any> {
    // 开发模式：使用模拟上传
    if (DEV_MODE) {
      console.log('🔧 开发模式：模拟文档上传', {
        filename: data.file.name,
        fileSize: data.file.size,
        fileType: data.file.type,
        folderId: data.folder_id,
        title: data.title,
        description: data.description
      });
      
      // 模拟上传延迟
      await new Promise(resolve => setTimeout(resolve, 1000));
      
      // 生成模拟的文档数据
      const mockDocument: Document = {
        id: `mock-doc-${Date.now()}`,
        title: data.title || data.file.name.replace(/\.[^/.]+$/, ''),
        description: data.description || '上传的测试文档',
        status: 'uploaded',
        type: 'pdf',
        original_filename: data.file.name,
        file_size: data.file.size,
        file_type: 'application/pdf',
        mime_type: data.file.type,
        conversion_status: 'converted',
        page_count: Math.floor(Math.random() * 50) + 1,
        folder_id: data.folder_id,
        uploaded_by: 'admin',
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString(),
        ai_category: 'document',
        ai_confidence: 0.85,
        ai_tags: { category: 'report', type: 'pdf' },
        ai_summary: '这是一个模拟上传的PDF文档',
        classification_status: 'classified'
      };
      
      // 将模拟文档存储到内存中，以便后续查询
      mockUploadedDocuments.push(mockDocument);
      console.log('✅ 模拟上传成功，已存储到内存:', mockDocument);
      console.log('📊 当前内存中文档总数:', mockUploadedDocuments.length);
      return mockDocument;
    }
    
    // 生产模式：调用真实API
    const formData = new FormData();
    formData.append('file', data.file);
    formData.append('folder_id', data.folder_id);
    if (data.title) formData.append('title', data.title);
    if (data.description) formData.append('description', data.description);
    if (data.document_type) formData.append('document_type', data.document_type);

    const response = await api.post('/documents/upload/', formData, {
      headers: {
        'Content-Type': 'multipart/form-data',
      },
      timeout: 300000, // 5分钟超时，适应大文件上传
      onUploadProgress: (progressEvent) => {
        if (progressEvent.total) {
          const percentCompleted = Math.round((progressEvent.loaded * 100) / progressEvent.total);
          console.log(`📤 上传进度: ${percentCompleted}%`);
        }
      },
    });
    return response.data;
  }

  // 更新文档信息
  async updateDocument(documentId: string, data: Partial<Document>): Promise<Document> {
    const response = await api.put(`/documents/${documentId}`, data);
    return response.data;
  }

  // 删除文档
