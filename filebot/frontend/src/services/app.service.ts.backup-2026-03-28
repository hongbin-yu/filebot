  }): Promise<App[]> {
    const response = await api.get('/apps/', { params });
    return response.data;
  }

  // 获取单个应用详情
  async getAppById(appId: string): Promise<App> {
    // 检查appId是否是保留路径（如client, login, register等）
    const reservedPaths = ['client', 'login', 'register', 'documents', 'folders', 'upload', 'apps', 'dashboard'];
    if (reservedPaths.includes(appId.toLowerCase())) {
      throw new Error(`"${appId}" is a reserved path and cannot be used as an application identifier`);
    }
    
    // 检查是否为有效的UUID格式
    const isValidUUID = (id: string): boolean => {
      const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
      return uuidRegex.test(id);
    };
    
    // 如果是有效的UUID，直接调用API
    if (isValidUUID(appId)) {
      const response = await api.get(`/apps/${appId}`);
      return response.data;
    }
    
    // 如果不是UUID，可能是短ID或slug
    // 先尝试直接调用（可能返回404）
    try {
      const response = await api.get(`/apps/${appId}`);
      return response.data;
    } catch (error: any) {
      // 如果返回404，尝试通过获取所有应用来查找
      if (error.response?.status === 404) {
        // 获取所有应用
        const allApps = await this.getApps();
        
        // 查找ID前8字符匹配的应用（短ID）
        const appIdWithoutHyphens = appId.replace(/-/g, '');
        const matchedApp = allApps.find(app => {
          const appIdWithoutHyphensFull = app.id.replace(/-/g, '');
          return appIdWithoutHyphensFull.startsWith(appIdWithoutHyphens);
        });
        
        if (matchedApp) {
          // 返回匹配的应用
          return matchedApp;
        }
        
        // 如果没有找到，查找名称slug匹配的应用
        const slugMatchedApp = allApps.find(app => {
          const appSlug = app.name.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, '');
          return appSlug === appId;
        });
        
        if (slugMatchedApp) {
          return slugMatchedApp;
        }
        
        // 如果都没有找到，重新抛出原始错误
        throw error;
      }
      
      // 如果不是404错误，重新抛出
      throw error;
    }
  }

