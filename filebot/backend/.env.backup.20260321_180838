# FileBot 环境配置
# 基于 .env.example 修改

# 应用配置
APP_NAME="FileBot"
APP_VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=True

# 安全配置
SECRET_KEY="dev-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7天

# 数据库配置
# SQLite（开发环境）
DATABASE_URL="sqlite:///./filebot.db"

# PostgreSQL（生产环境）
# DATABASE_URL="postgresql://user:password@localhost:5432/filebot"

# Redis配置（用于缓存和任务队列）
REDIS_URL="redis://localhost:6379/0"

# 文件存储配置
FILE_STORAGE_PATH="./data/files"
TEMP_STORAGE_PATH="./data/temp"
MAX_FILE_SIZE=104857600  # 100MB

# 默认管理员账户
DEFAULT_SUPERUSER_EMAIL="admin@filebot.com"
DEFAULT_SUPERUSER_USERNAME="admin"
DEFAULT_SUPERUSER_PASSWORD="admin123"

# 转换配置
CONVERSION_TIMEOUT=300  # 5分钟
CONCURRENT_CONVERSIONS=5

# 日志配置
LOG_LEVEL="INFO"
LOG_FILE="./logs/filebot.log"

# CORS允许的来源（JSON数组格式）
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]